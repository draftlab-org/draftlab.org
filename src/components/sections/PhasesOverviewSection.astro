---
import { getCollection } from 'astro:content';
import Heading from '@components/atoms/Heading.astro';
import Text from '@components/atoms/Text.astro';
import { isVisible } from '@utils/content';
import { renderMarkdown } from '@utils/renderMarkdown';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const phasesRaw = await getCollection('phases');
const phases = phasesRaw
  .filter((e) => isVisible(e))
  .sort((a, b) => a.data.number - b.data.number);

const phaseDescriptionHtml = new Map<string, string>();
for (const phase of phases) {
  const rendered = await renderMarkdown(phase.data.description);
  phaseDescriptionHtml.set(phase.data.slug, rendered?.html ?? phase.data.description);
}

const phaseTextColor: Record<string, string> = {
  understand: 'text-phase-understand-dark',
  define: 'text-phase-define-dark',
  deliver: 'text-phase-deliver-dark',
  sustain: 'text-phase-sustain-dark',
};
---

<div class="py-4">
  {title && (
    <div class="mb-8 max-w-2xl">
      <Heading level={2} class="mb-3">{title}</Heading>
      {description && (
        <Text size="lg" class="text-ink-soft">{description}</Text>
      )}
    </div>
  )}

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {phases.map((phase) => {
      const cardGradient = `linear-gradient(to right, var(--color-phase-${phase.data.slug}-light), var(--color-white))`;
      return (
        <a
          href={`/work?phases=${phase.data.slug}`}
          class="group flex flex-col p-5 no-underline shadow-sm transition-shadow duration-150 hover:shadow-md"
          style={`background: ${cardGradient};`}
          aria-label={`See ${phase.data.name} phase projects`}
        >
          <h3 class:list={['font-serif text-xl font-normal', phaseTextColor[phase.data.slug]]}>
            {phase.data.name}
          </h3>
          <div class="prose prose-sm mt-3 max-w-none text-sm leading-relaxed text-ink-soft" set:html={phaseDescriptionHtml.get(phase.data.slug)} />
        </a>
      );
    })}
  </div>
</div>
