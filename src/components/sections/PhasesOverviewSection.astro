---
import { getCollection } from 'astro:content';
import SectionTitle from '@components/atoms/SectionTitle.astro';
import Text from '@components/atoms/Text.astro';
import { isVisible } from '@utils/content';
import { renderMarkdown } from '@utils/renderMarkdown';

export interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

const PHASE_ORDER = ['understand', 'define', 'deliver', 'sustain'] as const;

const phasesRaw = await getCollection('phases');
const phases = phasesRaw
	.filter((e) => isVisible(e))
	.sort((a, b) => {
		const ai = PHASE_ORDER.indexOf(a.data.slug as (typeof PHASE_ORDER)[number]);
		const bi = PHASE_ORDER.indexOf(b.data.slug as (typeof PHASE_ORDER)[number]);
		return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
	});

const phaseDescriptionHtml = new Map<string, string>();
for (const phase of phases) {
	const rendered = await renderMarkdown(phase.data.description);
	phaseDescriptionHtml.set(
		phase.data.slug,
		rendered?.html ?? phase.data.description
	);
}
---

<section class="text-ink">
	{
		title && (
			<header class="mb-10 flex flex-col items-start gap-4 md:mb-14">
				<SectionTitle title={title} />
				{description && (
					<Text size="lg" class="max-w-2xl text-ink-soft">
						{description}
					</Text>
				)}
			</header>
		)
	}

	{/* Mobile: vertical timeline. A single continuous sand line runs from below
	    the first dot to the bottom of the sustain row; each phase row punches
	    its phase-color dot through via z-10. Body description flows in the
	    right column under the mono name + tagline. */}
	<ol class="relative flex flex-col lg:hidden">
		<span
			class="pointer-events-none absolute top-[13px] bottom-0 left-[3px] w-px bg-sand"
			aria-hidden="true"
		></span>
		{
			phases.map((phase) => (
				<li class="flex gap-4 pb-12 last:pb-0">
					<div class="w-2 shrink-0 pt-[5px]">
						<span
							class="relative z-10 block h-2 w-2 rounded-full"
							style={`background: var(--color-phase-${phase.data.slug}-dark);`}
							aria-hidden="true"
						/>
					</div>

					<div class="flex min-w-0 flex-1 flex-col">
						<span
							class="font-mono text-[0.78rem] tracking-[0.2em] uppercase"
							style={`color: var(--color-phase-${phase.data.slug}-dark);`}
						>
							{phase.data.name}
						</span>
						{phase.data.tagline && (
							<p class="mt-2 font-mono text-[0.65rem] tracking-[0.18em] text-ink-muted/80 uppercase">
								{phase.data.tagline}
							</p>
						)}
						<div
							class="prose prose-sm mt-4 max-w-none text-ink-soft"
							set:html={phaseDescriptionHtml.get(phase.data.slug)}
						/>
					</div>
				</li>
			))
		}
	</ol>

	{/* Desktop (lg+): 4-column grid. Each column tops with the homepage-style
	    horizontal track marker — dot + mono name + flex-1 sand line that
	    bridges into the next column via a negative right margin (last column
	    holds its line at the column edge). Tagline and body flow below. */}
	<div class="hidden grid-cols-4 gap-x-10 lg:grid">
		{
			phases.map((phase, i) => (
				<div class="flex flex-col">
					<div class="flex items-center gap-2.5">
						<span
							class="relative z-10 block h-2 w-2 shrink-0 rounded-full"
							style={`background: var(--color-phase-${phase.data.slug}-dark);`}
							aria-hidden="true"
						/>
						<span
							class="font-mono text-[0.78rem] tracking-[0.2em] uppercase whitespace-nowrap"
							style={`color: var(--color-phase-${phase.data.slug}-dark);`}
						>
							{phase.data.name}
						</span>
						<span
							class="block h-px flex-1 bg-sand"
							style={
								i < phases.length - 1
									? 'margin-right: -2.5rem;'
									: undefined
							}
							aria-hidden="true"
						/>
					</div>

					{phase.data.tagline && (
						<p class="mt-3 font-mono text-[0.65rem] tracking-[0.18em] text-ink-muted/80 uppercase">
							{phase.data.tagline}
						</p>
					)}

					<div
						class="prose prose-sm mt-5 max-w-none text-ink-soft"
						set:html={phaseDescriptionHtml.get(phase.data.slug)}
					/>
				</div>
			))
		}
	</div>
</section>
