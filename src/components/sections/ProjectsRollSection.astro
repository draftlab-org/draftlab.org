---
import { getCollection } from 'astro:content';
import Heading from '@components/atoms/Heading.astro';
import Text from '@components/atoms/Text.astro';
import ProjectCard from '@components/molecules/ProjectCard.astro';
import { getProjects, getFeaturedProjects, getProjectsByPhase, getProjectsByModality } from '@utils/projects';
import { getOrganisations } from '@utils/organisations';
import { isVisible } from '@utils/content';

export interface Props {
  title?: string;
  description?: string;
  limit?: number;
  filterPhase?: string;
  filterModality?: string;
  featuredOnly?: boolean;
}

const {
  title,
  description,
  limit,
  filterPhase,
  filterModality,
  featuredOnly = false,
} = Astro.props;

let projects = featuredOnly
  ? await getFeaturedProjects()
  : filterPhase
    ? await getProjectsByPhase(filterPhase)
    : filterModality
      ? await getProjectsByModality(filterModality)
      : await getProjects();

if (limit) {
  projects = projects.slice(0, limit);
}

// Build org name lookup
const orgs = await getOrganisations();
const orgNames = new Map(orgs.map((o) => [o.data.id, o.data.name]));

// Build skills lookup
const allSkills = await getCollection('skills');
const skillsBySlug = new Map(
  allSkills
    .filter((s) => isVisible(s))
    .map((s) => [s.data.slug, { name: s.data.name, slug: s.data.slug, icon: s.data.icon }])
);
---

<div class="py-4">
  {title && (
    <div class="mb-8 max-w-2xl">
      <Heading level={2} class="mb-3">{title}</Heading>
      {description && (
        <Text size="lg" class="text-ink-soft">{description}</Text>
      )}
    </div>
  )}

  {projects.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard
          name={project.data.name}
          slug={project.data.slug}
          description={project.data.description}
          client={project.data.client ? orgNames.get(project.data.client) : undefined}
          phases={project.data.phases}
          skills={project.data.skills?.map((s: string) => skillsBySlug.get(s)).filter(Boolean) as any}
          projectStatus={project.data.projectStatus}
          featured={project.data.featured}
          image={project.data.image}
        />
      ))}
    </div>
  ) : (
    <p class="text-ink-muted italic">No projects to show.</p>
  )}
</div>
