---
import SectionTitle from '@components/atoms/SectionTitle.astro';
import Text from '@components/atoms/Text.astro';
import ProjectCard from '@components/molecules/ProjectCard.astro';
import { getProjects, getFeaturedProjects, getProjectsByPhase, getProjectsByModality } from '@utils/projects';
import { getOrganisations } from '@utils/organisations';

export interface Props {
  title?: string;
  description?: string;
  limit?: number;
  filterPhase?: string;
  filterModality?: string;
  featuredOnly?: boolean;
}

const {
  title,
  description,
  limit,
  filterPhase,
  filterModality,
  featuredOnly = false,
} = Astro.props;

let projects = featuredOnly
  ? await getFeaturedProjects()
  : filterPhase
    ? await getProjectsByPhase(filterPhase)
    : filterModality
      ? await getProjectsByModality(filterModality)
      : await getProjects();

if (limit) {
  projects = projects.slice(0, limit);
}

const orgs = await getOrganisations();
const orgById = new Map(orgs.map((o) => [o.data.id, o.data]));
---

<div class="py-4">
  {title && (
    <div class="mb-8 flex max-w-2xl flex-col gap-3">
      <SectionTitle title={title} />
      {description && (
        <Text size="lg" class="text-ink-soft">{description}</Text>
      )}
    </div>
  )}

  {projects.length > 0 ? (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard
          name={project.data.name}
          slug={project.data.slug}
          description={project.data.description}
          client={project.data.client ? orgById.get(project.data.client)?.name : undefined}
          clientLogo={project.data.client ? orgById.get(project.data.client)?.image : undefined}
          phases={project.data.phases}
          skills={project.data.skills}
          projectStatus={project.data.projectStatus}
          featured={project.data.featured}
          image={project.data.image}
          class={project.data.image ? 'sm:col-span-2' : ''}
        />
      ))}
    </div>
  ) : (
    <p class="text-ink-muted italic">No projects to show.</p>
  )}
</div>
