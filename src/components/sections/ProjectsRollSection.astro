---
import SectionTitle from '@components/atoms/SectionTitle.astro';
import Text from '@components/atoms/Text.astro';
import ProjectCard from '@components/molecules/ProjectCard.astro';
import { getOrganisations } from '@utils/organisations';
import { getFeaturedProjects, getProjects, getProjectsByModality, getProjectsByPhase } from '@utils/projects';

export interface Props {
  title?: string;
  description?: string;
  limit?: number;
  filterPhase?: string;
  filterModality?: string;
  featuredOnly?: boolean;
  hideImages?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  limit,
  filterPhase,
  filterModality,
  featuredOnly = false,
  hideImages = false,
  wide = false,
} = Astro.props;

const gridCols = wide
  ? 'grid-cols-1 sm:grid-cols-2'
  : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
const cardAspect = wide
  ? ' [&_h2]:text-3xl'
  : '';

let projects = featuredOnly
  ? await getFeaturedProjects()
  : filterPhase
    ? await getProjectsByPhase(filterPhase)
    : filterModality
      ? await getProjectsByModality(filterModality)
      : await getProjects();

if (limit) {
  projects = projects.slice(0, limit);
}

const orgs = await getOrganisations();
const orgById = new Map(orgs.map((o) => [o.data.id, o.data]));
---

<div>
	{
		title && (
			<div class="mb-8 flex max-w-2xl flex-col gap-3">
				<SectionTitle title={title} />
				{description && (
					<Text size="lg" class="text-ink-soft">
						{description}
					</Text>
				)}
			</div>
		)
	}

	{
		projects.length > 0 ? (
			<>
				<div class:list={['grid gap-4', gridCols]}>
					{projects.map((project) => (
						<ProjectCard
							name={project.data.name}
							slug={project.data.slug}
							description={project.data.description}
							client={
								project.data.client
									? orgById.get(project.data.client)?.name
									: undefined
							}
							clientLogo={
								project.data.client
									? orgById.get(project.data.client)?.image
									: undefined
							}
							phases={project.data.phases}
							skills={project.data.skills}
							projectStatus={project.data.projectStatus}
							image={hideImages ? undefined : project.data.image}
							class:list={[
								!hideImages && project.data.image ? 'sm:col-span-2' : '',
								cardAspect,
							]}
						/>
					))}
				</div>

				<div class="mt-14 flex justify-end pt-4 md:mt-16">
					<a
						href="/projects"
						class="group inline-flex items-center gap-4 no-underline"
					>
						<span class="font-mono text-sm tracking-[0.22em] text-ink uppercase md:text-[0.95rem]">
							See all projects
						</span>
						<span
							aria-hidden="true"
							class="block h-px w-12 bg-ink-muted/60 transition-[width,background-color] duration-300 group-hover:w-20 group-hover:bg-ink"
						/>
						<span
							aria-hidden="true"
							class="font-mono text-base text-ink transition-transform duration-300 group-hover:translate-x-1 md:text-lg"
						>
							→
						</span>
					</a>
				</div>
			</>
		) : (
			<p class="text-ink-muted italic">No projects to show.</p>
		)
	}
</div>
