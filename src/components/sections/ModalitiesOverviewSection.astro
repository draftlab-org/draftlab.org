---
import { getCollection } from 'astro:content';
import Heading from '@components/atoms/Heading.astro';
import ModalityIcon from '@components/atoms/ModalityIcon.astro';
import Text from '@components/atoms/Text.astro';
import { isVisible } from '@utils/content';
import type { ModalitySlug } from '@utils/modalityIcons';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const modalitiesRaw = await getCollection('modalities');
const modalities = modalitiesRaw
  .filter((e) => isVisible(e))
  .sort((a, b) => a.data.order - b.data.order);
---

<div class="py-4">
  {title && (
    <div class="mb-8 max-w-2xl">
      <Heading level={2} class="mb-3">{title}</Heading>
      {description && (
        <Text size="lg" class="text-ink-soft">{description}</Text>
      )}
    </div>
  )}

  <div class="grid gap-4 sm:grid-cols-3">
    {modalities.map((modality) => (
      <a
        href={`/work?modalities=${modality.data.slug}`}
        class="flex flex-col bg-white p-6 no-underline shadow-sm transition-shadow duration-150 hover:shadow-md"
        aria-label={`See ${modality.data.name} projects`}
      >
        <div class="flex items-center gap-4">
          <ModalityIcon
            slug={modality.data.slug as ModalitySlug}
            size={56}
            asMask
            decorative
            class="gradient-phase shrink-0"
          />
          <h3 class="font-serif text-xl font-medium text-ink">
            {modality.data.name}
          </h3>
        </div>
        <p class="mt-3 text-sm italic text-ink-muted">
          {modality.data.tagline}
        </p>
      </a>
    ))}
  </div>
</div>
