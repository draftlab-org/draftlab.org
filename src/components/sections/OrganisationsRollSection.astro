---
import SectionTitle from '@components/atoms/SectionTitle.astro';
import Text from '@components/atoms/Text.astro';
import { getOrganisations, getOrganisationsByType } from '@utils/organisations';

export interface Props {
  title?: string;
  description?: string;
  filterType?: 'client' | 'partner' | 'funder';
  limit?: number;
}

const { title, description, filterType, limit } = Astro.props;

let orgs = filterType
  ? await getOrganisationsByType(filterType)
  : await getOrganisations();

if (limit) {
  orgs = orgs.slice(0, limit);
}

const orgsWithLogos = orgs.filter((o) => o.data.image);
---

<div class="py-4">
  {title && (
    <div class="mb-10 flex max-w-2xl flex-col gap-3">
      <SectionTitle title={title} />
      {description && (
        <Text size="lg" class="text-ink-soft">{description}</Text>
      )}
    </div>
  )}

  {orgsWithLogos.length > 0 ? (
    <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {orgsWithLogos.map((org) => {
        const imgSrc = typeof org.data.image === 'string' ? org.data.image : org.data.image!.src;
        const tile = (
          <div class="org-tile relative aspect-video overflow-hidden">
            <img
              src={imgSrc}
              alt={org.data.name}
              title={org.data.name}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-contain p-6 md:p-8"
            />
          </div>
        );

        return org.data.url ? (
          <a
            href={org.data.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={org.data.name}
            class="block"
          >
            {tile}
          </a>
        ) : (
          tile
        );
      })}
    </div>
  ) : (
    <p class="text-ink-muted italic">No organisations to show.</p>
  )}
</div>

<style>
  .org-tile img {
    filter: grayscale(100%);
    transition: filter 0.3s ease;
  }

  a:hover .org-tile img {
    filter: grayscale(0%);
  }
</style>
