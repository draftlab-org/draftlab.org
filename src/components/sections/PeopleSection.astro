---
import { getCollection } from 'astro:content';
import Image from '@components/atoms/Image.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import SocialLinks from '@components/molecules/SocialLinks.astro';
import { isVisible } from '@utils/content';

export interface Props {
  category?: string;
}

const { category } = Astro.props;

const peopleEntries = await getCollection('people');
const allPeople = peopleEntries
  .filter((entry) => isVisible(entry))
  .map((entry) => entry.data);

const people = category
  ? allPeople.filter((person) => person.sections.includes(category))
  : allPeople;
---

<div class="grid gap-x-12 gap-y-20 md:grid-cols-2 lg:grid-cols-3">
	{
		people.map((person) => {
			const roleLabel = person.role || person.title;

			return (
				<div class="flex flex-col">
					{person.headshot && (
						<div class="flex aspect-5/4 w-full items-center justify-center corner-brackets text-ink">
							<div class="aspect-5/4 w-4/5">
								<Image
									src={person.headshot}
									alt={person.name}
									width={480}
									height={384}
									class="block h-full w-full object-cover"
								/>
							</div>
						</div>
					)}

					<div class="flex flex-1 flex-col pt-5">
						{roleLabel && (
							<p class="font-mono text-[0.65rem] tracking-[0.22em] text-ink-muted uppercase">
								{roleLabel}
							</p>
						)}
						<h3 class="mt-1.5 font-serif text-2xl leading-tight font-normal text-ink md:text-3xl">
							{person.name}
						</h3>
						{person.social && (
							<SocialLinks
								social={person.social}
								class="mt-2 gap-2"
								iconClass="w-4 h-4"
								linkClass="bg-ink-muted/60 hover:gradient-phase"
							/>
						)}
						{person.bio && (
							<p class="mt-3 text-sm leading-relaxed text-ink-soft">
								{person.bio}
							</p>
						)}
						{person.skills && person.skills.length > 0 && (
							<div class="mt-auto flex flex-wrap gap-2 pt-5">
								{person.skills.map((slug) => (
									<SkillIcon slug={slug} size={16} class="text-ink-muted" />
								))}
							</div>
						)}
					</div>
				</div>
			);
		})
	}
</div>

{
	people.length === 0 && (
		<div class="py-12 text-center text-gray-500">No people found.</div>
	)
}
