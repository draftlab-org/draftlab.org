---
import { getCollection } from 'astro:content';
import Image from '@components/atoms/Image.astro';
import Link from '@components/atoms/Link.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import { isVisible } from '@utils/content';
import IconLink from '~icons/heroicons/link-20-solid';

export interface Props {
  category?: string;
}

const { category } = Astro.props;

const peopleEntries = await getCollection('people');
const allPeople = peopleEntries
  .filter((entry) => isVisible(entry))
  .map((entry) => entry.data);

const people = category
  ? allPeople.filter((person) => person.sections.includes(category))
  : allPeople;
---

<div class="grid gap-8 md:grid-cols-2">
	{
		people.map((person) => (
			<div class="gradient-phase-light flex items-start gap-5 p-5 shadow-sm">
				{person.headshot && (
					<div class="relative aspect-3/4 w-28 shrink-0 sm:w-32">
						<Image
							src={person.headshot}
							alt={person.name}
							width={240}
							height={320}
							class="block h-full w-full object-cover"
						/>
						<span
							class="pointer-events-none absolute inset-0 shadow-inner"
							aria-hidden="true"
						/>
					</div>
				)}
				<div class="flex min-w-0 flex-1 flex-col self-stretch">
					<div class="flex items-center gap-1.5">
						<h3 class="font-serif text-2xl font-normal text-ink">
							{person.name}
						</h3>
						{person.url && (
							<Link
								href={person.url}
								variant="unstyled"
								class="text-ink-muted transition-colors hover:text-secondary-500"
								aria-label={`${person.name}'s personal website`}
								external
							>
								<IconLink class="size-4" aria-hidden="true" />
							</Link>
						)}
					</div>
					{person.bio && (
						<p class="mt-2 text-sm leading-relaxed text-ink-soft">
							{person.bio}
						</p>
					)}
					{person.skills && person.skills.length > 0 && (
						<div class="mt-auto flex flex-wrap justify-end gap-2 pt-3">
							{person.skills.map((slug) => (
								<SkillIcon
									slug={slug}
									size={18}
									class="text-ink-muted transition-colors hover:text-secondary-500"
								/>
							))}
						</div>
					)}
				</div>
			</div>
		))
	}
</div>

{
	people.length === 0 && (
		<div class="py-12 text-center text-gray-500">No people found.</div>
	)
}
