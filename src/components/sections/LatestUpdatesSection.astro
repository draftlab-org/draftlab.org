---
import { Image } from 'astro:assets';
import SectionTitle from '@components/atoms/SectionTitle.astro';
import { getOrganisations } from '@utils/organisations';
import { getProjects } from '@utils/projects';
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: string;
  description?: string;
  limit?: number;
}

const { title = 'Latest updates', limit = 4 } = Astro.props;

const [projects, organisations] = await Promise.all([
  getProjects(),
  getOrganisations(),
]);

const orgById = new Map(organisations.map((o) => [o.data.id, o.data]));

const dateFmt = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

interface Resolved {
  date: string;
  dateLabel: string;
  update: string;
  projectName: string;
  projectSlug: string;
  clientName?: string;
  image?: ImageMetadata;
  title?: string;
}

// Take first paragraph of (potentially rich-text) update for the card preview.
const firstParagraph = (md: string) =>
  md.split(/\n{2,}/, 1)[0]?.trim() ?? md;

const resolved: Resolved[] = projects
  .flatMap((project) => {
    const client = project.data.client
      ? orgById.get(project.data.client)
      : undefined;
    return (project.data.updates ?? []).map((u) => ({
      date: u.date,
      dateLabel: dateFmt.format(new Date(u.date)),
      update: firstParagraph(u.update),
      projectName: project.data.name,
      projectSlug: project.data.slug,
      clientName: client?.name,
      image: u.image,
      title: u.title,
    }));
  })
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date))
  .slice(0, limit);
---

{
	resolved.length > 0 && (
		<div class="py-8 text-white md:py-14 lg:py-20">
			<header class="mb-10 md:mb-8">
				<SectionTitle title={title} class="text-white" />
			</header>

			<ol class="space-y-12 md:space-y-8">
				{resolved.map((r, i) => (
					<li class="dispatch group/dispatch" style={`--i: ${i}`}>
						<a href={`/projects/${r.projectSlug}`} class="block no-underline">
							{/* Mono kicker — mobile: project + client stacked, no labels */}
							<div class="flex flex-col gap-y-1 font-mono text-[0.65rem] leading-normal tracking-[0.2em] text-white uppercase md:hidden">
								<span class="text-white underline decoration-white/60 decoration-dotted underline-offset-[0.32em]">
									{r.projectName}
								</span>
								{r.clientName && r.clientName !== r.projectName && (
									<span class="text-white/85">{r.clientName}</span>
								)}
							</div>

							{/* Mono kicker — desktop: FOR project · WITH client (inline) */}
							<div class="hidden flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[0.7rem] tracking-[0.2em] text-white uppercase tabular-nums md:flex">
								<span class="flex items-center gap-2">
									<span class="text-white/85">For</span>
									<span class="text-white underline decoration-white/60 decoration-dotted underline-offset-[0.32em] transition-[text-decoration-color] duration-200 group-hover/dispatch:decoration-white">
										{r.projectName}
									</span>
								</span>
								{r.clientName && r.clientName !== r.projectName && (
									<>
										<span aria-hidden="true" class="text-white/60">
											·
										</span>
										<span class="text-white">
											<span class="text-white/85">With </span> {r.clientName}
										</span>
									</>
								)}
							</div>

							{/* Body row — image (when present) + Fraunces update text */}
							<div class="mt-3 flex items-start gap-4 md:mt-3 md:gap-5">
								{r.image && (
									<figure
										class="aspect-4/3 w-20 shrink-0 overflow-hidden md:w-24"
										aria-hidden="true"
									>
										<Image
											src={r.image}
											alt={r.title ?? r.update}
											widths={[120, 192, 240]}
											sizes="(min-width: 768px) 96px, 80px"
											class="block h-full w-full object-cover"
										/>
									</figure>
								)}
								<p class="min-w-0 flex-1 font-serif text-lg leading-[1.32] font-light text-white md:text-[1.2rem] md:leading-[1.28] lg:text-[1.4rem] lg:leading-[1.22]">
									{r.update}
								</p>
							</div>

							{/* Footer cue — desktop only */}
							<div class="mt-4 hidden items-center gap-3 font-mono text-[0.75rem] tracking-[0.22em] text-white uppercase md:inline-flex">
								<span
									aria-hidden="true"
									class="block h-px w-8 bg-white/60 transition-all duration-300 group-hover/dispatch:w-14 group-hover/dispatch:bg-white"
								/>
								<span>Visit project page</span>
								<span
									aria-hidden="true"
									class="inline-block transition-transform duration-300 group-hover/dispatch:translate-x-1"
								>
									→
								</span>
							</div>
						</a>
					</li>
				))}
			</ol>

			{/* Closing bar — link to all projects */}
			<div class="mt-14 flex justify-end pt-4 md:mt-16">
				<a
					href="/projects"
					class="group inline-flex items-center gap-4 no-underline"
				>
					<span class="font-mono text-sm tracking-[0.22em] text-white uppercase md:text-[0.95rem]">
						See all projects
					</span>
					<span
						aria-hidden="true"
						class="block h-px w-12 bg-white/60 transition-[width,background-color] duration-300 group-hover:w-20 group-hover:bg-white"
					/>
					<span
						aria-hidden="true"
						class="font-mono text-base text-white transition-transform duration-300 group-hover:translate-x-1 md:text-lg"
					>
						→
					</span>
				</a>
			</div>
		</div>
	)
}

<style>
	/* Stagger-fade entry — desktop only. On mobile it amplified the layout
	   shift across narrow viewports and read as messy. */
	@media (min-width: 768px) {
		.dispatch {
			animation: dispatch-in 0.7s cubic-bezier(0.2, 0.7, 0.25, 1) backwards;
			animation-delay: calc(var(--i, 0) * 90ms + 80ms);
		}
	}
	@keyframes dispatch-in {
		0% {
			opacity: 0;
			transform: translateY(14px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.dispatch {
			animation: none;
		}
	}
</style>
