---
import { getCollection } from 'astro:content';
import Eyebrow from '@components/atoms/Eyebrow';
import ModalityIcon from '@components/atoms/ModalityIcon.astro';
import SectionTitle from '@components/atoms/SectionTitle.astro';
import type { ModalitySlug } from '@utils/modalityIcons';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'How we work', description } = Astro.props;

const PHASE_ORDER = ['understand', 'define', 'deliver', 'sustain'] as const;
type PhaseSlug = (typeof PHASE_ORDER)[number];

const [phaseEntries, modalityEntries] = await Promise.all([
  getCollection('phases'),
  getCollection('modalities'),
]);

const phaseBySlug = new Map(phaseEntries.map((p) => [p.data.slug, p.data]));

interface PhaseColumn {
  slug: PhaseSlug;
  name: string;
  tagline: string;
}

const phases: PhaseColumn[] = PHASE_ORDER.map((slug) => {
  const meta = phaseBySlug.get(slug);
  return {
    slug,
    name: meta?.name ?? slug,
    tagline: meta?.tagline ?? '',
  };
});

const modalities = modalityEntries
  .slice()
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => ({
    slug: m.data.slug as ModalitySlug,
    name: m.data.name,
    tagline: m.data.tagline,
  }));
---

<section class="text-ink">
	<header class="mb-10 flex flex-col items-start gap-4 md:mb-14">
		<SectionTitle title={title} class="text-ink" />
		{
			description && (
				<p class="max-w-2xl font-serif text-base leading-relaxed text-ink-soft md:text-lg">
					{description}
				</p>
			)
		}
	</header>

	{/* Axis label — Phases */}
	<Eyebrow as="p" tone="subtle" className="mb-6 md:mb-8">Across phases</Eyebrow>

	{
		/* Mobile: vertical timeline. A single continuous line behind the
	    dot column runs from below the first dot to the bottom of the
	    sustain row. Dots sit on top of the line via `relative z-10`, so
	    they punch through. Phase name + tagline in the right column —
	    different x position from the line, so no overlap. */
	}
	<ol class="relative flex flex-col sm:hidden">
		<span
			class="pointer-events-none absolute top-3.25 bottom-0 left-0.5 gradient-rule-vertical"
			aria-hidden="true"></span>
		{
			phases.map((col) => (
				<li class="flex gap-4 pb-10 last:pb-0">
					<div class="w-2 shrink-0 pt-1.25">
						<span
							class="relative z-10 block h-2 w-2 rounded-full"
							style={`background: var(--color-phase-${col.slug}-dark);`}
							aria-hidden="true"
						/>
					</div>

					<div class="flex flex-col gap-1.5">
						<span
							class="font-mono text-[0.78rem] tracking-[0.2em] uppercase"
							style={`color: var(--color-phase-${col.slug}-dark);`}
						>
							{col.name}
						</span>
						{col.tagline && (
							<p class="font-serif text-sm leading-relaxed text-ink-soft">
								{col.tagline}
							</p>
						)}
					</div>
				</li>
			))
		}
	</ol>

	{
		/* Desktop: horizontal timeline. Dot + name in a flex row with a
	    `flex-1` connector that auto-aligns to the dot's vertical centre.
	    First three phases use a negative right margin to bridge into the
	    next column; the last phase keeps natural flex-1, so the line
	    ends at the column's right edge — i.e. the container's right
	    edge — extending the track past sustain. Tagline lives in a
	    separate row below, never crossed by the line. */
	}
	<div class="hidden grid-cols-4 gap-x-10 sm:grid">
		{
			phases.map((col, i) => (
				<div class="flex flex-col">
					<div class="flex items-center gap-2.5">
						<span
							class="relative z-10 block h-2 w-2 shrink-0 rounded-full"
							style={`background: var(--color-phase-${col.slug}-dark);`}
							aria-hidden="true"
						/>
						<span
							class="font-mono text-[0.78rem] tracking-[0.2em] uppercase"
							style={`color: var(--color-phase-${col.slug}-dark);`}
						>
							{col.name}
						</span>
						<span
							class="block gradient-rule flex-1"
							style={
								i < phases.length - 1 ? 'margin-right: -2.5rem;' : undefined
							}
							aria-hidden="true"
						/>
					</div>

					{col.tagline && (
						<p class="mt-3 font-serif text-sm leading-relaxed text-ink-soft md:text-base">
							{col.tagline}
						</p>
					)}
				</div>
			))
		}
	</div>

	{/* Axis label — Modalities */}
	<Eyebrow as="p" tone="subtle" className="mt-16 mb-6 md:mt-20 md:mb-8">
		And across modalities
	</Eyebrow>

	{
		/* Modalities — 3-up grid on desktop, stacked on mobile. Each cell
	    pairs the modality icon (mark) with name and a short tagline.
	    Mirrors the phases column structure: header row (icon + name) on
	    top, tagline below. */
	}
	<div class="grid grid-cols-1 gap-y-10 sm:grid-cols-3 sm:gap-x-10 sm:gap-y-0">
		{
			modalities.map((m) => (
				<div class="flex gap-4 sm:flex-col sm:gap-3">
					<ModalityIcon
						slug={m.slug}
						size={48}
						class="mt-0.5 shrink-0 gradient-phase sm:mt-0"
						asMask
					/>
					<div class="flex flex-col gap-1.5">
						<span class="font-mono text-[0.78rem] tracking-[0.2em] text-ink uppercase">
							{m.name}
						</span>
						<p class="font-serif text-sm leading-relaxed text-ink-soft md:text-base">
							{m.tagline}
						</p>
					</div>
				</div>
			))
		}
	</div>

	{/* Closing — link to about */}
	<div class="mt-14 flex justify-end md:mt-20">
		<a href="/about" class="group inline-flex items-center gap-4 no-underline">
			<span
				class="font-mono text-sm tracking-[0.22em] text-ink uppercase md:text-[0.95rem]"
			>
				Read about our approach
			</span>
			<span
				aria-hidden="true"
				class="block h-px w-12 bg-ink-muted/60 transition-[width,background-color] duration-300 group-hover:w-20 group-hover:bg-ink"
			></span>
			<span
				aria-hidden="true"
				class="font-mono text-base text-ink transition-transform duration-300 group-hover:translate-x-1 md:text-lg"
			>
				→
			</span>
		</a>
	</div>
</section>
