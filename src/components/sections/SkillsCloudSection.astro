---
import { getCollection } from 'astro:content';
import Heading from '@components/atoms/Heading.astro';
import Text from '@components/atoms/Text.astro';
import SkillsCloud, {
  type SkillsCloudSkill,
} from '@components/organisms/SkillsCloud';
import hugeiconsPack from '@iconify/json/json/hugeicons.json';
import { getIconData, iconToHTML, iconToSVG } from '@iconify/utils';
import { isVisible } from '@utils/content';

export interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
}

const {
  eyebrow,
  heading = 'Creative project design for social good champions.',
  body,
} = Astro.props;

const skillsRaw = await getCollection('skills');
const skills = skillsRaw
  .filter((e) => isVisible(e))
  .map((e) => e.data)
  .sort((a, b) => a.name.localeCompare(b.name));

const renderIconSvg = (iconId: string, size = 48): string => {
  const [, name] = iconId.split(':');
  const data = getIconData(hugeiconsPack, name);
  if (!data) return '';
  const rendered = iconToSVG(data, { height: size, width: size });
  return iconToHTML(rendered.body, {
    ...rendered.attributes,
    width: String(size),
    height: String(size),
  });
};

const cloudSkills: SkillsCloudSkill[] = skills.map((s) => ({
  slug: s.slug,
  name: s.name,
  iconSvg: renderIconSvg(s.icon, 48),
}));
---

<div
	class="relative overflow-hidden md:grid md:grid-cols-2 md:items-center md:gap-16"
>
	{/* Single SkillsCloud island. On mobile: absolute backdrop behind the
	    heading (decorative, opacity-15). On desktop: in-flow grid column 1
	    alongside the heading. `md:relative md:z-10` is load-bearing — without
	    a stacking context above siblings here, hover hit-tests don't reach the
	    cloud on desktop and the mousemove-driven 3D effect dies. */}
	<div
		data-skills-cloud-root
		class="skills-cloud-inverted pointer-events-none absolute top-0 block h-96 w-lg opacity-15 md:pointer-events-auto md:relative md:z-10 md:col-start-1 md:h-auto md:w-auto md:opacity-100"
	>
		<div class="skills-cloud-wrap h-auto">
			<SkillsCloud client:visible skills={cloudSkills} />
		</div>
	</div>

	<div
		class="relative flex h-96 max-w-xl items-center md:col-start-2 md:h-auto"
	>
		{
			eyebrow && (
				<p class="mb-3 text-xs font-medium tracking-wide text-white/85 uppercase">
					{eyebrow}
				</p>
			)
		}
		<Heading
			level={2}
			class="pb-2 text-balance text-white"
		>
			{heading}
		</Heading>
		{
			body && (
				<Text size="lg" class="mt-4 text-white/85">
					{body}
				</Text>
			)
		}
	</div>

	<ul class="sr-only">
		{skills.map((s) => <li>{s.name}</li>)}
	</ul>
</div>

<style is:global>
	.skills-cloud-inverted .skills-cloud__icon {
		color: var(--color-cream, #fff);
	}

	.skills-cloud-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 1 / 1;
	}

	.skills-cloud {
		position: absolute;
		inset: 0;
		perspective: 1000px;
		transform-style: preserve-3d;
		--mx: 0px;
		--my: 0px;
		--sy: 0px;
	}

	.skills-cloud__icon {
		position: absolute;
		width: var(--size, 40px);
		height: var(--size, 40px);
		margin-left: calc(var(--size, 40px) * -0.5);
		margin-top: calc(var(--size, 40px) * -0.5);
		color: var(--color-ink-soft, currentColor);
		transform: translate3d(
			calc((var(--mx) + var(--sy)) * var(--depth, 1)),
			calc((var(--my) + var(--sy)) * var(--depth, 1)),
			var(--z, 0px)
		);
		transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
		animation: skills-cloud-float var(--duration, 8s) ease-in-out
			calc(var(--delay, 0s) * -1) infinite;
		will-change: transform;
	}

	.skills-cloud[data-returning='true'] .skills-cloud__icon {
		transition: transform 3s cubic-bezier(0.22, 1, 0.36, 1) 400ms;
	}

	.skills-cloud[data-returning='entering'] .skills-cloud__icon {
		transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.skills-cloud__icon > svg {
		width: 100%;
		height: 100%;
		display: block;
	}

	@keyframes skills-cloud-float {
		0%,
		100% {
			translate: 0 -3px;
		}
		50% {
			translate: 0 3px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skills-cloud__icon {
			animation: none;
			transition: none;
			transform: translate3d(0, 0, var(--z, 0px));
		}
	}
</style>
