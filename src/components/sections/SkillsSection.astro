---
import { getCollection } from 'astro:content';
import Heading from '@components/atoms/Heading.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import Text from '@components/atoms/Text.astro';
import { isVisible } from '@utils/content';

export interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const skillsRaw = await getCollection('skills');
const skills = skillsRaw
  .filter((e) => isVisible(e))
  .map((e) => e.data)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<div class="py-4">
  {title && (
    <div class="mb-8 max-w-2xl">
      <Heading level={2} class="mb-3">{title}</Heading>
      {description && (
        <Text size="lg" class="text-ink-soft">{description}</Text>
      )}
    </div>
  )}

  <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
    {skills.map((skill) => (
      <div class="group flex items-stretch gap-4 transition-colors">
        <div class="flex aspect-square w-12 shrink-0 items-center justify-center">
          <SkillIcon
            slug={skill.slug}
            asMask
            class="gradient-phase h-full w-full"
          />
        </div>
        <div class="min-w-0 self-center">
          <h3 class="font-serif text-sm font-normal leading-tight text-ink">
            {skill.name}
          </h3>
          {skill.description && (
            <p class="mt-1 line-clamp-2 text-xs leading-snug text-ink-soft">
              {skill.description}
            </p>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
