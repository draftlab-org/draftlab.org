---
import { Image } from 'astro:assets';
import type { ProjectUpdate } from 'src/content.config';
import { renderMarkdownWithImages } from '@utils/renderMarkdown';

export interface Props {
	updates?: ProjectUpdate[];
}

const { updates = [] } = Astro.props;

const sorted = [...updates].sort(
	(a, b) => Date.parse(b.date) - Date.parse(a.date),
);

const dateFmt = new Intl.DateTimeFormat('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
});

const rendered = await Promise.all(
	sorted.map(async (u) => ({
		update: (await renderMarkdownWithImages(u.update)).html,
		body: u.body ? (await renderMarkdownWithImages(u.body)).html : '',
	})),
);

const total = sorted.length;
---

{
	sorted.length > 0 && (
		<section>
			<h2 class="mb-10 font-serif text-sm font-medium tracking-widest text-ink-muted uppercase">
				Updates
			</h2>

			<ol class="space-y-16">
				{sorted.map((entry, i) => {
					const dateLabel = dateFmt.format(new Date(entry.date));
					const number = String(total - i).padStart(3, '0');
					const hasHeadingMatter = entry.title || entry.image;
					return (
						<li class="grid gap-x-8 gap-y-3 md:grid-cols-[6.5rem_1fr]">
							{/* Gutter — number prominent, date subordinate */}
							<aside class="flex flex-row items-baseline gap-3 md:flex-col md:items-start md:gap-0">
								<span
									class="font-mono text-base leading-none font-medium tracking-[0.15em] text-secondary-600 uppercase tabular-nums"
									aria-hidden="true"
								>
									№ {number}
								</span>
								<time
									datetime={entry.date}
									class="font-mono text-[0.65rem] tracking-[0.18em] text-ink-muted uppercase tabular-nums md:mt-2"
								>
									{dateLabel}
								</time>
							</aside>

							{/* Content column */}
							<div>
								{entry.title && (
									<h3 class="font-serif text-2xl leading-[1.15] font-medium text-ink md:text-[1.75rem]">
										{entry.title}
									</h3>
								)}

								{entry.image && (
									<figure
										class:list={[
											'corner-brackets aspect-16/10 w-full p-3 text-ink',
											entry.title ? 'mt-6' : 'mt-0',
										]}
									>
										<div class="h-full w-full overflow-hidden">
											<Image
												src={entry.image}
												alt={entry.title ?? ''}
												class="block h-full w-full object-cover"
											/>
										</div>
									</figure>
								)}

								<div
									class:list={[
										'prose-ink prose max-w-none leading-relaxed text-ink-soft *:first:mt-0 [&>p]:font-serif [&>p]:text-[1.0625rem]',
										hasHeadingMatter ? 'mt-6' : 'mt-0',
									]}
									set:html={rendered[i].update}
								/>

								{rendered[i].body && (
									<div
										class="prose-ink prose relative mt-5 max-w-none pl-5 leading-relaxed text-ink-soft *:first:mt-0 [&>p]:font-serif [&>p]:text-base before:absolute before:inset-y-0 before:left-0 before:gradient-rule-vertical before:content-['']"
										set:html={rendered[i].body}
									/>
								)}
							</div>
						</li>
					);
				})}
			</ol>
		</section>
	)
}
