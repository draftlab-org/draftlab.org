---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { isVisible } from '@utils/content';
import { renderMarkdownWithImages } from '@utils/renderMarkdown';

export interface Props {
	projectSlug: string;
}

const { projectSlug } = Astro.props;

const allUpdates = await getCollection('updates');

const updates = allUpdates
	.filter((entry) => {
		if (!isVisible(entry)) return false;
		const ref = entry.data.project as unknown;
		const refSlug =
			typeof ref === 'string'
				? ref
				: (ref as { id?: string; slug?: string })?.id ??
					(ref as { slug?: string })?.slug ??
					'';
		return refSlug === projectSlug;
	})
	.sort((a, b) => Date.parse(b.data.date) - Date.parse(a.data.date));

const dayFmt = new Intl.DateTimeFormat('en-GB', { day: '2-digit' });
const monthFmt = new Intl.DateTimeFormat('en-GB', { month: 'long' });
const yearFmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric' });
const longDateFmt = new Intl.DateTimeFormat('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});

const renderedBodies = await Promise.all(
	updates.map(async (entry) =>
		entry.data.body ? (await renderMarkdownWithImages(entry.data.body)).html : ''
	)
);

const total = updates.length;
---

{
	updates.length > 0 && (
		<section class="mb-12">
			<header class="mb-10 flex items-baseline justify-between border-b border-sand pb-3">
				<h2 class="font-serif text-sm font-medium tracking-widest text-ink-muted uppercase">
					Updates
				</h2>
				<span class="font-mono text-[0.65rem] tracking-[0.18em] text-ink-muted/70 uppercase">
					{total === 1 ? '1 dispatch' : `${total} dispatches`}
				</span>
			</header>

			<ol class="space-y-20">
				{updates.map((entry, i) => {
					const dateObj = new Date(entry.data.date);
					const day = dayFmt.format(dateObj);
					const month = monthFmt.format(dateObj);
					const year = yearFmt.format(dateObj);
					const longDate = longDateFmt.format(dateObj);
					const dispatchNo = String(total - i).padStart(3, '0');
					const bodyHtml = renderedBodies[i];
					const hasHeadingMatter = entry.data.title || entry.data.image;
					return (
						<li class="grid gap-x-10 gap-y-5 md:grid-cols-[6.5rem_1fr]">
							{/* Gutter — typographic anchor */}
							<aside class="flex flex-row items-baseline gap-4 md:flex-col md:items-start md:gap-0">
								<span
									class="font-mono text-[0.65rem] tracking-[0.22em] text-secondary-600 uppercase"
									aria-hidden="true"
								>
									№ {dispatchNo}
								</span>
								<time
									datetime={entry.data.date}
									class="flex flex-row items-baseline gap-2 md:mt-3 md:flex-col md:items-start md:gap-0"
								>
									<span class="font-serif text-5xl font-light leading-none text-ink tabular-nums md:text-6xl">
										{day}
									</span>
									<span class="font-mono text-[0.7rem] tracking-[0.15em] text-ink-muted uppercase md:mt-2">
										{month}
									</span>
									<span class="font-mono text-[0.7rem] tracking-[0.15em] text-ink-muted/70 uppercase md:mt-0.5">
										{year}
									</span>
									<span class="sr-only">— {longDate}</span>
								</time>
							</aside>

							{/* Content column */}
							<div class="md:pl-2">
								{entry.data.title && (
									<h3 class="font-serif text-2xl leading-[1.15] font-medium text-ink md:text-[1.75rem]">
										{entry.data.title}
									</h3>
								)}

								{entry.data.image && (
									<figure
										class:list={[
											'corner-brackets aspect-16/10 w-full text-secondary-500',
											entry.data.title ? 'mt-6' : 'mt-0',
										]}
									>
										<div class="h-full w-full overflow-hidden">
											<Image
												src={entry.data.image}
												alt={entry.data.title ?? entry.data.update}
												class="block h-full w-full object-cover"
											/>
										</div>
									</figure>
								)}

								<p
									class:list={[
										'font-serif text-[1.0625rem] leading-relaxed text-ink-soft',
										hasHeadingMatter ? 'mt-6' : 'mt-0',
									]}
								>
									{entry.data.update}
								</p>

								{bodyHtml && (
									<div
										class="prose-ink prose mt-5 max-w-none border-l border-sand/70 pl-5 text-ink-soft italic [&>:first-child]:mt-0 [&>p]:font-serif"
										set:html={bodyHtml}
									/>
								)}
							</div>
						</li>
					);
				})}
			</ol>
		</section>
	)
}
