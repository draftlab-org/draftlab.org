---
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import { ClientRouter } from "astro:transitions";

// Fetch site config from content collection
const siteConfigEntry = await getEntry('site', 'config');

if (!siteConfigEntry) {
  throw new Error('Site configuration not found');
}

const siteConfig = siteConfigEntry.data;


export interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  canonicalURL?: URL;
}

const {
  title,
  description = siteConfig.description,
  image,
  canonicalURL,
} = Astro.props;

const siteName = siteConfig.title;
const fullTitle =
  title === siteName || title.includes(siteName) ? title : `${title} [${siteName}]`;

const ogImage = image || (siteConfig.defaultOgImage as ImageMetadata | undefined);
const ogImageSquare = siteConfig.defaultOgImageSquare as ImageMetadata | undefined;
const imageURL = ogImage ? new URL(ogImage.src, Astro.url).href : undefined;
const imageSquareURL = ogImageSquare && !image
  ? new URL(ogImageSquare.src, Astro.url).href
  : undefined;
const imageAlt = `${siteName} — ${siteConfig.description}`;
const mimeFor = (img?: ImageMetadata) =>
  img?.format ? `image/${img.format === 'jpg' ? 'jpeg' : img.format}` : 'image/png';

const isProd = import.meta.env.PROD;

// Derive `@user@instance` from a Mastodon profile URL (e.g. https://mastodon.social/@tingeber)
const mastodonUrl = siteConfig.social?.mastodon;
const fediverseCreator = (() => {
  if (!mastodonUrl) return undefined;
  try {
    const u = new URL(mastodonUrl);
    const handle = u.pathname.replace(/^\/+/, '').replace(/^@/, '');
    return handle ? `@${handle}@${u.hostname}` : undefined;
  } catch {
    return undefined;
  }
})();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteName}
	href={new URL('rss.xml', Astro.site)}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}
{imageURL && <meta property="og:image:secure_url" content={imageURL} />}
{
	ogImage?.width && (
		<meta property="og:image:width" content={String(ogImage.width)} />
	)
}
{
	ogImage?.height && (
		<meta property="og:image:height" content={String(ogImage.height)} />
	)
}
{imageURL && <meta property="og:image:type" content={mimeFor(ogImage)} />}
{imageURL && <meta property="og:image:alt" content={imageAlt} />}

{
	/* Optional square thumbnail variant — Slack inline previews, iMessage, RSS readers */
}
{imageSquareURL && <meta property="og:image" content={imageSquareURL} />}
{
	imageSquareURL && (
		<meta property="og:image:secure_url" content={imageSquareURL} />
	)
}
{
	imageSquareURL && ogImageSquare?.width && (
		<meta property="og:image:width" content={String(ogImageSquare.width)} />
	)
}
{
	imageSquareURL && ogImageSquare?.height && (
		<meta property="og:image:height" content={String(ogImageSquare.height)} />
	)
}
{
	imageSquareURL && (
		<meta property="og:image:type" content={mimeFor(ogImageSquare)} />
	)
}
{imageSquareURL && <meta property="og:image:alt" content={imageAlt} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
{imageURL && <meta name="twitter:image:alt" content={imageAlt} />}


<!-- Mastodon verification -->
<link rel="me" href="https://mastodon.social/@draftlab"/>
<!-- Mastodon (Fediverse) author byline -->
{
	fediverseCreator && (
		<meta name="fediverse:creator" content={fediverseCreator} />
	)
}

{
	isProd && (
		<>
			{/* Privacy-preserving analytics by self-hosted Umami */}
			<script
				is:inline
				defer
				src="https://umami.draftlab.dev/script.js"
				data-performance="true"
				data-do-not-track="true"
				data-website-id="1e20487e-8c1d-4f9d-974b-d15a43c4ca66"
				transition:persist
			/>
			{/* Auto-tag outbound links for Umami. Sweep on DOM ready + each
			    view transition. */}
			<script>
				(function () {
					if (document.documentElement.dataset.outboundLinkTracker) return;
					document.documentElement.dataset.outboundLinkTracker = 'true';
					function tagLink(a:any) {
						if (!a.host || a.host === window.location.host) return;
						if (a.dataset.umamiEvent) return;
						a.dataset.umamiEvent = 'outbound-link-click';
						a.dataset.umamiEventUrl = a.href;
					}
					function tagAll() {
						document.querySelectorAll('a[href]').forEach(tagLink);
					}
					if (document.readyState === 'loading') {
						document.addEventListener('DOMContentLoaded', tagAll);
					} else {
						tagAll();
					}
					document.addEventListener('astro:page-load', tagAll);
				})();
			</script>
		</>
	)
}

<!-- Local Font Declaration.
     `preload` is granular: preload only the variants needed to paint above-the-fold
     content. Fraunces 700 latin = the hero headline (LCP on `/`) and the logo;
     Fraunces 400 latin = nav menu items and body text. The other declared
     weights/subsets still load on demand via the injected @font-face rules.
     JetBrains Mono is below the fold everywhere — no preload. -->
<Font
	cssVariable="--font-fraunces"
	preload={[
		{ weight: 400, style: 'normal', subset: 'latin' },
		{ weight: 700, style: 'normal', subset: 'latin' },
	]}
/>
<Font cssVariable="--font-jetbrains-mono" />

<ClientRouter />

<!-- Additional head content -->
<slot />
