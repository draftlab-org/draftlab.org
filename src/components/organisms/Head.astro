---
import { Font } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { ClientRouter } from "astro:transitions";
import JsonLd from '@components/atoms/JsonLd.astro';
import { isVisible } from '@utils/content';
import { buildSiteGraph } from '@utils/structuredData';

// Fetch site config from content collection
const siteConfigEntry = await getEntry('site', 'config');

if (!siteConfigEntry) {
  throw new Error('Site configuration not found');
}

const siteConfig = siteConfigEntry.data;


export interface Props {
  title: string;
  description?: string;
  /** Page-specific OG image; falls back to `siteConfig.defaultOgImage`. */
  image?: ImageMetadata;
  canonicalURL?: URL;
  /** `article` for dated, authored pages (projects); `website` otherwise. */
  type?: 'website' | 'article';
  /** ISO dates, only emitted when `type` is `article`. */
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = siteConfig.description,
  image,
  canonicalURL,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteName = siteConfig.title;
const fullTitle =
  title === siteName || title.includes(siteName) ? title : `${title} [${siteName}]`;

const base = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, base).href;

const mimeFor = (img?: ImageMetadata) =>
  img?.format ? `image/${img.format === 'jpg' ? 'jpeg' : img.format}` : 'image/png';

// Primary OG image: page image, else the site-wide default.
const ogImage = image || (siteConfig.defaultOgImage as ImageMetadata | undefined);
type OgImage = { url: string; width?: number; height?: number; type: string };
const og: OgImage | undefined = ogImage
  ? { url: absolute(ogImage.src), width: ogImage.width, height: ogImage.height, type: mimeFor(ogImage) }
  : undefined;

// Square variant only accompanies the generic default; per-page heroes
// shouldn't get a generic square thumbnail tacked on.
const ogImageSquare = siteConfig.defaultOgImageSquare as ImageMetadata | undefined;
const imageSquareURL =
  ogImageSquare && !image ? absolute(ogImageSquare.src) : undefined;
const imageAlt = `${siteName} — ${siteConfig.description}`;

// Site-wide structured data: Organization + WebSite. Pages add their own
// entity (Person, CreativeWork) through the <slot />.
const logo = siteConfig.defaultLogoLight as ImageMetadata | undefined;
const skillNames = (await getCollection('skills'))
  .filter((s) => isVisible(s))
  .map((s) => s.data.name)
  .sort();
const siteGraph = buildSiteGraph({
  siteUrl: base.href,
  name: siteName,
  description: siteConfig.description,
  logoUrl: logo ? absolute(logo.src) : undefined,
  email: siteConfig.email,
  sameAs: Object.values(siteConfig.social ?? {}),
  knowsAbout: skillNames,
});

const isProd = import.meta.env.PROD;

// Derive `@user@instance` from a Mastodon profile URL (e.g. https://mastodon.social/@tingeber)
const mastodonUrl = siteConfig.social?.mastodon;
const fediverseCreator = (() => {
  if (!mastodonUrl) return undefined;
  try {
    const u = new URL(mastodonUrl);
    const handle = u.pathname.replace(/^\/+/, '').replace(/^@/, '');
    return handle ? `@${handle}@${u.hostname}` : undefined;
  } catch {
    return undefined;
  }
})();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteName}
	href={new URL('rss.xml', Astro.site)}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{og && <meta property="og:image" content={og.url} />}
{og && <meta property="og:image:secure_url" content={og.url} />}
{og?.width && <meta property="og:image:width" content={String(og.width)} />}
{og?.height && <meta property="og:image:height" content={String(og.height)} />}
{og && <meta property="og:image:type" content={og.type} />}
{og && <meta property="og:image:alt" content={imageAlt} />}

{
	/* Optional square thumbnail variant — Slack inline previews, iMessage, RSS readers */
}
{imageSquareURL && <meta property="og:image" content={imageSquareURL} />}
{
	imageSquareURL && (
		<meta property="og:image:secure_url" content={imageSquareURL} />
	)
}
{
	imageSquareURL && ogImageSquare?.width && (
		<meta property="og:image:width" content={String(ogImageSquare.width)} />
	)
}
{
	imageSquareURL && ogImageSquare?.height && (
		<meta property="og:image:height" content={String(ogImageSquare.height)} />
	)
}
{
	imageSquareURL && (
		<meta property="og:image:type" content={mimeFor(ogImageSquare)} />
	)
}
{imageSquareURL && <meta property="og:image:alt" content={imageAlt} />}

<!-- Article dates (projects) -->
{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime} />
	)
}
{
	type === 'article' && modifiedTime && (
		<meta property="article:modified_time" content={modifiedTime} />
	)
}
{type === 'article' && <meta property="article:publisher" content={absolute('/')} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{og && <meta name="twitter:image" content={og.url} />}
{og && <meta name="twitter:image:alt" content={imageAlt} />}

<!-- Structured data (site-wide); pages append their own via the head slot -->
<JsonLd data={siteGraph} />

<!-- Mastodon verification -->
<link rel="me" href="https://mastodon.social/@draftlab"/>
<!-- Mastodon (Fediverse) author byline -->
{
	fediverseCreator && (
		<meta name="fediverse:creator" content={fediverseCreator} />
	)
}

{
	isProd && (
		<>
			{/* Privacy-preserving analytics by self-hosted Umami */}
			<script
				is:inline
				defer
				src="https://umami.draftlab.dev/script.js"
				data-performance="true"
				data-do-not-track="true"
				data-website-id="1e20487e-8c1d-4f9d-974b-d15a43c4ca66"
				transition:persist
			/>
			{/* Auto-tag outbound links for Umami. Sweep on DOM ready + each
			    view transition. */}
			<script>
				(function () {
					if (document.documentElement.dataset.outboundLinkTracker) return;
					document.documentElement.dataset.outboundLinkTracker = 'true';
					function tagLink(a:any) {
						if (!a.host || a.host === window.location.host) return;
						if (a.dataset.umamiEvent) return;
						a.dataset.umamiEvent = 'outbound-link-click';
						a.dataset.umamiEventUrl = a.href;
					}
					function tagAll() {
						document.querySelectorAll('a[href]').forEach(tagLink);
					}
					if (document.readyState === 'loading') {
						document.addEventListener('DOMContentLoaded', tagAll);
					} else {
						tagAll();
					}
					document.addEventListener('astro:page-load', tagAll);
				})();
			</script>
		</>
	)
}

<!-- Local Font Declaration.
     `preload` is granular: preload only the variants needed to paint above-the-fold
     content. Fraunces 700 latin = the hero headline (LCP on `/`) and the logo;
     Fraunces 400 latin = nav menu items and body text. The other declared
     weights/subsets still load on demand via the injected @font-face rules.
     JetBrains Mono is below the fold everywhere — no preload. -->
<Font
	cssVariable="--font-serif-family"
	preload={[
		{ weight: 400, style: 'normal', subset: 'latin' },
		{ weight: 700, style: 'normal', subset: 'latin' },
	]}
/>
<Font cssVariable="--font-mono-family" />
<Font cssVariable="--font-sans-family" />

<ClientRouter />

<!-- Additional head content -->
<slot />
