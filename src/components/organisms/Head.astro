---
import { Font } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { ClientRouter } from "astro:transitions";
import JsonLd from '@components/atoms/JsonLd.astro';
import { isVisible } from '@utils/content';
import { isPreview, isProduction } from '@utils/dev';
import type { JsonLd as JsonLdNode } from '@utils/jsonld';
import { metaDescription, ogCardUrl, ogLocale } from '@utils/seo';
import { buildSiteGraph } from '@utils/structuredData';

// Fetch site config from content collection
const siteConfigEntry = await getEntry('site', 'config');


if (!siteConfigEntry) {
  throw new Error('Site configuration not found');
}

const siteConfig = siteConfigEntry.data;

// Umami is opt-in: only emitted on production builds when both fields are set
const umami = siteConfig.analytics?.umami;
const umamiEnabled = isProduction && !!umami?.src && !!umami?.websiteId;

export interface ArticleMeta {
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Absolute URLs of the authors' profile pages. */
  authors?: string[];
  section?: string;
  tags?: string[];
}

export interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  canonicalURL?: URL;
  lang?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Keep the page out of search indexes (also forced on preview builds). */
  noindex?: boolean;
  /** Page-specific schema.org nodes, merged into the site graph. */
  jsonLd?: JsonLdNode | JsonLdNode[];
  article?: ArticleMeta;
}

const {
  title,
  description,
  image,
  canonicalURL,
  lang = 'en',
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  article,
} = Astro.props;

// Draftlab title format: "Page [Draftlab]" (Scaffold's default is "Page | Site").
const siteName = siteConfig.title;
const fullTitle =
  title === siteName || title.includes(siteName) ? title : `${title} [${siteName}]`;
const metaDesc = metaDescription(description, siteConfig.description);
const locale = ogLocale(lang);
const siteBase = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, siteBase).href;

const mimeFor = (img?: ImageMetadata) =>
  img?.format ? `image/${img.format === 'jpg' ? 'jpeg' : img.format}` : undefined;

// og:image — the generated OG card when the page has a hero image and the
// site can build cards (square logo set); otherwise the hero image itself,
// otherwise the default site OG image. Always absolute on the site URL.
let imageURL: string | undefined;
let imageType: string | undefined;
let imageWidth: number | undefined;
let imageHeight: number | undefined;
const card = image ? ogCardUrl(Astro.url.pathname) : undefined;
if (card) {
  imageURL = card;
  imageType = 'image/png';
  imageWidth = 1200;
  imageHeight = 630;
} else {
  const fallback = image ?? (siteConfig.defaultOgImage as ImageMetadata | undefined);
  if (fallback) {
    imageURL = absolute(fallback.src);
    imageType = mimeFor(fallback);
    imageWidth = fallback.width;
    imageHeight = fallback.height;
  }
}
const imageAlt = `${siteName} — ${siteConfig.description}`;

// Square variant only accompanies the generic default; per-page heroes
// shouldn't get a generic square thumbnail tacked on.
const ogImageSquare = siteConfig.defaultOgImageSquare as ImageMetadata | undefined;
const imageSquareURL =
  ogImageSquare && !image ? absolute(ogImageSquare.src) : undefined;

const robots = noindex || isPreview ? 'noindex, nofollow' : undefined;

// Site-wide structured data: Organization (+ knowsAbout = skills) + WebSite.
// Pages add their own nodes (Person, CreativeWork) through the `jsonLd` prop.
const logo = siteConfig.defaultLogoLight as ImageMetadata | undefined;
const skillNames = (await getCollection('skills'))
  .filter((s) => isVisible(s))
  .map((s) => s.data.name)
  .sort();
const siteGraph = buildSiteGraph({
  siteUrl: siteBase.href,
  name: siteName,
  description: siteConfig.description,
  logoUrl: logo ? absolute(logo.src) : undefined,
  email: siteConfig.email,
  sameAs: Object.values(siteConfig.social ?? {}),
  knowsAbout: skillNames,
});
const graph: JsonLdNode[] = [
  ...siteGraph['@graph'],
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
];

// Derive `@user@instance` from a Mastodon profile URL (e.g. https://mastodon.social/@tingeber)
const mastodonUrl = siteConfig.social?.mastodon;
const fediverseCreator = (() => {
  if (!mastodonUrl) return undefined;
  try {
    const u = new URL(mastodonUrl);
    const handle = u.pathname.replace(/^\/+/, '').replace(/^@/, '');
    return handle ? `@${handle}@${u.hostname}` : undefined;
  } catch {
    return undefined;
  }
})();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
<meta name="generator" content={Astro.generator} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={metaDesc} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteName} />
{locale && <meta property="og:locale" content={locale} />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDesc} />
{imageURL && <meta property="og:image" content={imageURL} />}
{imageURL && <meta property="og:image:secure_url" content={imageURL} />}
{imageURL && imageType && <meta property="og:image:type" content={imageType} />}
{imageURL && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageURL && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
{imageURL && <meta property="og:image:alt" content={imageAlt} />}

{
	/* Optional square thumbnail variant — Slack inline previews, iMessage, RSS readers */
}
{imageSquareURL && <meta property="og:image" content={imageSquareURL} />}
{imageSquareURL && <meta property="og:image:secure_url" content={imageSquareURL} />}
{
	imageSquareURL && ogImageSquare?.width && (
		<meta property="og:image:width" content={String(ogImageSquare.width)} />
	)
}
{
	imageSquareURL && ogImageSquare?.height && (
		<meta property="og:image:height" content={String(ogImageSquare.height)} />
	)
}
{
	imageSquareURL && mimeFor(ogImageSquare) && (
		<meta property="og:image:type" content={mimeFor(ogImageSquare)} />
	)
}
{imageSquareURL && <meta property="og:image:alt" content={imageAlt} />}

<!-- Article meta (projects) -->
{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
{ogType === 'article' && <meta property="article:publisher" content={absolute('/')} />}
{article?.authors?.map((url) => <meta property="article:author" content={url} />)}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDesc} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
{imageURL && <meta name="twitter:image:alt" content={imageAlt} />}

<!-- Structured data: Organization + WebSite, plus any page nodes -->
<JsonLd data={graph} />

<!-- Mastodon verification -->
<link rel="me" href="https://mastodon.social/@draftlab"/>
<!-- Mastodon (Fediverse) author byline -->
{
	fediverseCreator && (
		<meta name="fediverse:creator" content={fediverseCreator} />
	)
}

{
	umamiEnabled && (
		<>
			{/* Privacy-preserving analytics by Umami (configured in site config) */}
			<script
				is:inline
				defer
				src={umami?.src}
				data-performance="true"
				data-do-not-track="true"
				data-website-id={umami?.websiteId}
				transition:persist
			/>
			{/* Auto-tag outbound links for Umami. Sweep on DOM ready + each
			    view transition. */}
			<script>
				(function () {
					if (document.documentElement.dataset.outboundLinkTracker) return;
					document.documentElement.dataset.outboundLinkTracker = 'true';
					function tagLink(a:any) {
						if (!a.host || a.host === window.location.host) return;
						if (a.dataset.umamiEvent) return;
						a.dataset.umamiEvent = 'outbound-link-click';
						a.dataset.umamiEventUrl = a.href;
					}
					function tagAll() {
						document.querySelectorAll('a[href]').forEach(tagLink);
					}
					if (document.readyState === 'loading') {
						document.addEventListener('DOMContentLoaded', tagAll);
					} else {
						tagAll();
					}
					document.addEventListener('astro:page-load', tagAll);
				})();
			</script>
		</>
	)
}

<!-- Local Font Declaration (variables defined in fonts.config.mjs).
     `preload` is granular: preload only the variants needed to paint above-the-fold
     content. Fraunces 700 latin = the hero headline (LCP on `/`) and the logo;
     Fraunces 400 latin = nav menu items and body text. The other declared
     weights/subsets still load on demand via the injected @font-face rules.
     JetBrains Mono is below the fold everywhere — no preload. -->
<Font
	cssVariable="--font-serif-family"
	preload={[
		{ weight: 400, style: 'normal', subset: 'latin' },
		{ weight: 700, style: 'normal', subset: 'latin' },
	]}
/>
<Font cssVariable="--font-mono-family" />
<Font cssVariable="--font-sans-family" />

<ClientRouter />

<!-- Additional head content -->
<slot />
