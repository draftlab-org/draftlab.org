---
import Button from '@components/atoms/Button.astro';
import GradientLink from '@components/atoms/GradientLink.astro';
import Link from '@components/atoms/Link.astro';
import NavItem from '@components/molecules/NavItem.astro';
import MobileMenu from '@components/organisms/MobileMenu';
import RichSearch from '@components/organisms/RichSearch';
import type { NavItem as NavItemType } from '@utils/navigation';
import { resolveFlexibleLink } from '@utils/navigation';
import Image from 'astro/components/Image.astro';
import MagnifyingGlassIcon from '~icons/heroicons/magnifying-glass-20-solid';

export interface Props {
  items: NavItemType[];
  currentPath?: string;
  siteName?: string;
  class?: string;
	logo?: ImageMetadata
}

const {
  items,
  currentPath = Astro.url.pathname,
  siteName = 'Draftlab',
  class: className = '',
	logo,
} = Astro.props;

const isActive = (item: NavItemType) => {
  if (item.type === 'dropdown') {
    // Check if any child is active
    return item.children.some((child) => {
      const href = resolveFlexibleLink(child.link);
      if (href === '/') return currentPath === '/';
      return currentPath.startsWith(href);
    });
  }
  const href = resolveFlexibleLink(item.link);
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav class={`px-4 py-4 w-full bg-white ${className}`}>
	<div class="mx-auto flex max-w-7xl items-center justify-between">
		<!-- Left side: Logo -->
		<div class="shrink-0">
			<Link
				href="/"
				variant="unstyled"
				class="group font-serif text-2xl font-bold text-gray-900 underline decoration-primary-300 decoration-dotted decoration-4 underline-offset-8"
			>
				{
					logo ? (
						<span class="relative inline-block">
							<Image src={logo} alt={siteName} class="w-45" />
							<span
								aria-hidden="true"
								class="absolute inset-0 gradient-phase opacity-0 transition-opacity duration-200 group-hover:opacity-100"
								style={`mask-image: url(${logo.src}); -webkit-mask-image: url(${logo.src}); mask-size: contain; -webkit-mask-size: contain; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: left center; -webkit-mask-position: left center;`}
							/>
						</span>
					) : (
						<GradientLink text={siteName} as="span" trigger="group-hover" />
					)
				}
			</Link>
		</div>

		<!-- Right side: Nav Links + Search + Mobile Menu -->
		<div class="flex items-center gap-6">
			<!-- Navigation Links -->
			<div class="hidden items-center gap-x-6 md:flex lg:gap-x-8">
				{
					items.map((item) => (
						<NavItem
							item={item}
							active={isActive(item)}
							currentPath={currentPath}
							class="font-serif text-lg"
						/>
					))
				}
			</div>

			<!-- Search Button -->
			<Button
				variant="ghost"
				size="square"
				type="button"
				id="search-button"
				aria-label="Search"
			>
				<MagnifyingGlassIcon />
			</Button>

			<!-- CTA or Actions Slot -->
			<slot name="actions" />

			<!-- Mobile Menu -->
			<div class="md:hidden">
				<MobileMenu client:idle items={items} currentPath={currentPath} />
			</div>
		</div>
	</div>
</nav>

<!-- Rich Search Modal -->
<RichSearch client:idle />

<script>
	function setupSearchButton() {
		const searchButton = document.getElementById('search-button');

		if (searchButton) {
			searchButton.addEventListener('click', () => {
				window.dispatchEvent(new CustomEvent('open-search'));
			});
		}
	}

	// Run on initial load and after each View Transition navigation
	document.addEventListener('astro:page-load', setupSearchButton);

	// Listen for CMD+K or CTRL+K to open search
	// Use a data attribute to prevent duplicate listeners across View Transitions
	if (!document.documentElement.dataset.searchKeyboardListener) {
		document.documentElement.dataset.searchKeyboardListener = 'true';
		document.addEventListener('keydown', (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				e.preventDefault();
				window.dispatchEvent(new CustomEvent('open-search'));
			}
		});
	}
</script>
