---
import Button from '@components/atoms/Button';
import GradientLink from '@components/atoms/GradientLink.astro';
import Link from '@components/atoms/Link';
import NavItem from '@components/molecules/NavItem.astro';
import MobileMenu from '@components/organisms/MobileMenu';
import RichSearch from '@components/organisms/RichSearch';
import { siteConfig } from '@lib/config';
import type { NavItem as NavItemType } from '@utils/navigation';
import { isItemActive } from '@utils/navigation';
import Image from 'astro/components/Image.astro';
import MagnifyingGlassIcon from '~icons/heroicons/magnifying-glass-20-solid';

export interface Props {
  items: NavItemType[];
  currentPath?: string;
  siteName?: string;
  class?: string;
	logo?: ImageMetadata
}

const {
  items,
  currentPath = Astro.url.pathname,
  siteName = siteConfig.title,
  class: className = '',
	logo,
} = Astro.props;

const isActive = (item: NavItemType) => isItemActive(item, currentPath);
---

<nav class={`px-4 py-4 w-full bg-white ${className}`}>
	<div class="mx-auto flex max-w-7xl items-center justify-between">
		<!-- Left side: Logo -->
		<div class="shrink-0">
			<Link
				href="/"
				variant="unstyled"
				class="group font-serif text-2xl font-bold text-gray-900 underline decoration-primary-300 decoration-dotted decoration-4 underline-offset-8"
			>
				{
					logo ? (
						<span class="relative inline-block">
							<Image src={logo} alt={siteName} class="w-45" loading="eager" />
							<span
								aria-hidden="true"
								class="absolute inset-0 gradient-phase opacity-0 transition-opacity duration-200 group-hover:opacity-100"
								style={`mask-image: url(${logo.src}); -webkit-mask-image: url(${logo.src}); mask-size: contain; -webkit-mask-size: contain; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: left center; -webkit-mask-position: left center;`}
							/>
						</span>
					) : (
						<GradientLink text={siteName} as="span" trigger="group-hover" />
					)
				}
			</Link>
		</div>

		<!-- Right side: Nav Links + Search + Mobile Menu -->
		<div class="flex items-center gap-6">
			<!-- Navigation Links -->
			<div class="hidden items-center gap-x-6 md:flex lg:gap-x-8">
				{
					items.map((item) => (
						<NavItem
							item={item}
							active={isActive(item)}
							currentPath={currentPath}
							class="font-serif text-lg"
						/>
					))
				}
			</div>

			<!-- Search Button. The shortcut hint shows from md up and is rewritten
			     to ⌘ K on Apple devices by the script below -->
			<Button
				variant="ghost"
				size="square"
				type="button"
				id="search-button"
				aria-label="Search"
				class="gap-2 md:px-2"
			>
				<MagnifyingGlassIcon />
				<kbd
					id="search-shortcut"
					class="hidden rounded-sm border border-current/40 px-1.5 py-0.5 font-mono text-xs md:inline-block"
					aria-hidden="true"
				>
					Ctrl K
				</kbd>
			</Button>

			<!-- CTA or Actions Slot -->
			<slot name="actions" />

			<!-- Mobile Menu -->
			<!-- Only hydrated below the md breakpoint (48rem), where it's visible -->
			<div class="md:hidden">
				<MobileMenu
					client:media="(max-width: 47.99rem)"
					items={items}
					currentPath={currentPath}
					siteName={siteName}
				/>
			</div>
		</div>
	</div>
</nav>

<!-- Rich Search Modal. Hydrated when the browser is idle; an open request made
     before then is queued via data-search-pending and picked up on mount. -->
<RichSearch client:idle />

<script>
	function openSearch() {
		// Queue the request in case RichSearch hasn't hydrated yet
		document.documentElement.dataset.searchPending = 'true';
		window.dispatchEvent(new CustomEvent('open-search'));
	}

	const isApple = /Mac|iPhone|iPad/.test(navigator.platform);

	function setupSearchButton() {
		const searchButton = document.getElementById('search-button');

		if (searchButton) {
			searchButton.addEventListener('click', openSearch);
		}

		// Elements are re-created on each View Transition, so re-apply the hint
		const hint = document.getElementById('search-shortcut');
		if (hint && isApple) hint.textContent = '⌘ K';
	}

	// Run on initial load and after each View Transition navigation
	document.addEventListener('astro:page-load', setupSearchButton);

	// Listen for CMD+K or CTRL+K to open search
	// Use a data attribute to prevent duplicate listeners across View Transitions
	if (!document.documentElement.dataset.searchKeyboardListener) {
		document.documentElement.dataset.searchKeyboardListener = 'true';
		document.addEventListener('keydown', (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
				e.preventDefault();
				openSearch();
			}
		});
	}
</script>
