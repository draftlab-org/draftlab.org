---
import hugeiconsPack from '@iconify/json/json/hugeicons.json';
import { getIconData, iconToHTML, iconToSVG } from '@iconify/utils';
import { getSkillBySlug } from '@utils/skills';

export interface Props {
  slug: string;
  size?: number;
  class?: string;
  asMask?: boolean;
  title?: string;
  tooltip?: boolean;
}

const {
  slug,
  size = 20,
  class: className = '',
  asMask = false,
  title: titleOverride,
  tooltip = false,
} = Astro.props;

const skill = await getSkillBySlug(slug);
const icon = skill?.icon ?? '';
const title = titleOverride ?? skill?.name;

const [, iconName] = icon.split(':');
const iconData = iconName ? getIconData(hugeiconsPack, iconName) : null;

let svgHtml = '';
let maskUrl = '';

if (iconData) {
  const rendered = iconToSVG(iconData, { height: size, width: size });
  if (asMask) {
    const attrs = Object.entries(rendered.attributes)
      .map(([k, v]) => `${k}='${v}'`)
      .join(' ');
    const svg = `<svg xmlns='http://www.w3.org/2000/svg' ${attrs}>${rendered.body}</svg>`;
    maskUrl = `url("data:image/svg+xml;utf8,${encodeURIComponent(svg)}")`;
  } else {
    svgHtml = iconToHTML(rendered.body, rendered.attributes);
  }
}
---

{
	iconData && !tooltip && asMask && (
		<span
			class={className}
			role="img"
			aria-label={title}
			style={`display: inline-block; mask-image: ${maskUrl}; -webkit-mask-image: ${maskUrl}; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain;`}
		/>
	)
}
{
	iconData && !tooltip && !asMask && (
		<span
			class:list={['inline-flex', className]}
			role="img"
			aria-label={title}
			set:html={svgHtml}
		/>
	)
}
{
	iconData && tooltip && (
		<span class="group/skill-tooltip relative inline-flex">
			{asMask ? (
				<span
					class={className}
					role="img"
					aria-label={title}
					style={`display: inline-block; mask-image: ${maskUrl}; -webkit-mask-image: ${maskUrl}; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain;`}
				/>
			) : (
				<span
					class:list={['inline-flex', className]}
					role="img"
					aria-label={title}
					set:html={svgHtml}
				/>
			)}
			{title && (
				<span
					aria-hidden="true"
					class="pointer-events-none invisible absolute bottom-full left-1/2 z-50 mb-1.5 max-w-[8rem] -translate-x-1/2 translate-y-1 border border-ink/20 bg-white px-2 py-1 pb-[0.22rem] text-center font-mono text-[0.65rem] leading-tight font-medium tracking-[0.14em] text-ink uppercase opacity-0 shadow-[2px_2px_0_color-mix(in_srgb,var(--color-ink)_10%,transparent)] transition-[opacity,translate,visibility] duration-150 ease-out group-focus-within/skill-tooltip:visible group-focus-within/skill-tooltip:translate-y-0 group-focus-within/skill-tooltip:opacity-100 group-hover/skill-tooltip:visible group-hover/skill-tooltip:translate-y-0 group-hover/skill-tooltip:opacity-100 motion-reduce:translate-y-0 motion-reduce:transition-none"
				>
					{title}
				</span>
			)}
		</span>
	)
}
