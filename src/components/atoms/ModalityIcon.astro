---
import {
  type ModalitySlug,
  modalityIconSvgs,
} from '@utils/modalityIcons';

export interface Props {
  slug: ModalitySlug;
  size?: number;
  class?: string;
  title?: string;
  decorative?: boolean;
  asMask?: boolean;
}

const MODALITY_NAMES: Record<ModalitySlug, string> = {
  clinic: 'Clinic',
  studio: 'Studio',
  community: 'Community',
};

const {
  slug,
  size = 20,
  class: className = '',
  title,
  decorative = false,
  asMask = false,
} = Astro.props;

const svg = modalityIconSvgs[slug];
const label = title ?? MODALITY_NAMES[slug];

// For `asMask`, encode the SVG as a data URI and use it as a CSS mask-image
// on an empty span. Any background utility on that span (e.g. gradient-phase)
// then becomes the icon's rendered color.
let style = `width: ${size}px; height: ${size}px;`;
if (asMask && svg) {
  const maskUrl = `url("data:image/svg+xml;utf8,${encodeURIComponent(svg)}")`;
  style += ` mask-image: ${maskUrl}; -webkit-mask-image: ${maskUrl}; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-position: center; -webkit-mask-position: center; mask-size: contain; -webkit-mask-size: contain;`;
}
---

{
  svg && asMask && decorative && (
    <span
      class:list={['inline-block', className]}
      style={style}
      aria-hidden="true"
    />
  )
}
{
  svg && asMask && !decorative && (
    <span
      class:list={['inline-block', className]}
      style={style}
      role="img"
      aria-label={label}
    />
  )
}
{
  svg && !asMask && decorative && (
    <span
      class:list={['inline-block leading-none', className]}
      style={style}
      aria-hidden="true"
      set:html={svg}
    />
  )
}
{
  svg && !asMask && !decorative && (
    <span
      class:list={['inline-block leading-none', className]}
      style={style}
      role="img"
      aria-label={label}
      set:html={svg}
    />
  )
}
