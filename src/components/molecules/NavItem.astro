---
import Link from '@components/atoms/Link.astro';
import NavItemDropdown from '@components/molecules/NavItemDropdown';
import type { NavItem } from '@utils/navigation';
import { isExternalLink, resolveFlexibleLink } from '@utils/navigation';

export type Props = {
  item: NavItem;
  active?: boolean;
  currentPath?: string;
  class?: string;
}

const {
  item,
  active = false,
  currentPath = '',
  class: className = '',
} = Astro.props;

const activeStyles = active
  ? 'is-active'
  : '';

const classes = ` ${activeStyles} ${className}`;
---

{
	item.type === 'dropdown' ? (
		<NavItemDropdown
			client:load
			item={item}
			active={active}
			currentPath={currentPath}
		/>
	) : (
		<Link
			href={resolveFlexibleLink(item.link)}
			variant="brackets"
			class={classes}
			external={isExternalLink(item.link)}
		>
			{item.label}
			<slot />
		</Link>
	)
}
