---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PhaseTag from '@components/molecules/PhaseTag.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';

export interface Props {
  name: string;
  slug: string;
  description: string;
  client?: string;
  phases: Array<'understand' | 'define' | 'deliver' | 'sustain'>;
  skills?: Array<{ name: string; slug: string; icon: string }>;
  projectStatus?: 'active' | 'complete';
  featured?: boolean;
  image?: ImageMetadata;
  class?: string;
}

const {
  name,
  slug,
  description,
  client,
  phases,
  skills = [],
  projectStatus = 'complete',
  featured = false,
  image,
  class: className = '',
} = Astro.props;

const isActive = projectStatus === 'active';

const PHASE_ORDER = ['understand', 'define', 'deliver', 'sustain'] as const;
const orderedPhases = [...phases].sort(
  (a, b) => PHASE_ORDER.indexOf(a) - PHASE_ORDER.indexOf(b)
);
---

<a
  href={`/work/${slug}`}
  class:list={[
    'group relative block overflow-hidden rounded-lg border-2 border-sand bg-cream no-underline transition-colors duration-150 hover:border-secondary-400 [&_*]:no-underline',
    featured && 'ring-1 ring-secondary-200',
    className,
  ]}
>
  {/* Background image */}
  {image && (
    <div class="absolute inset-0 z-0 overflow-hidden">
      <Image
        src={image}
        alt=""
        aria-hidden="true"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
      {/* Legibility overlay: cream at bottom fading to transparent at top */}
      <div class="absolute inset-0 bg-gradient-to-t from-cream/95 via-cream/80 to-cream/30" />
    </div>
  )}

  {/* Phase color bar */}
  {orderedPhases[0] && (
    <div
      class:list={[
        'absolute top-0 left-0 right-0 z-20 h-[3px] opacity-60',
        orderedPhases[0] === 'understand' && 'bg-phase-understand',
        orderedPhases[0] === 'define' && 'bg-phase-define',
        orderedPhases[0] === 'deliver' && 'bg-phase-deliver',
        orderedPhases[0] === 'sustain' && 'bg-phase-sustain',
      ]}
    />
  )}

  <div class:list={['relative z-10 p-5', image && 'pt-32']}>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-serif text-lg font-normal leading-tight text-ink group-hover:text-secondary-600 transition-colors">
      {name}
    </h3>
    {isActive && (
      <span class="mt-0.5 flex-shrink-0 rounded-full bg-phase-understand-light px-2 py-0.5 text-[0.65rem] font-medium text-phase-understand-dark">
        Active
      </span>
    )}
  </div>

  {client && (
    <p class="mt-1 text-xs italic text-ink-muted">{client}</p>
  )}

  <p class="mt-3 text-sm leading-relaxed text-ink-soft line-clamp-3">{description}</p>

  {skills.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="text-ink-muted hover:text-secondary-500 transition-colors" title={skill.name}>
          <SkillIcon icon={skill.icon} size={18} />
        </span>
      ))}
    </div>
  )}

  <div class="mt-3 flex flex-wrap gap-1.5">
    {orderedPhases.map((phase) => (
      <PhaseTag phase={phase}>
        {phase.charAt(0).toUpperCase() + phase.slice(1)}
      </PhaseTag>
    ))}
  </div>
  </div>
</a>
