---
import { Image } from 'astro:assets';
import draftlabLogo from '@assets/draftlab-logo.svg';
import GradientLink from '@components/atoms/GradientLink.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import {
  getOrderedActivePhases,
  getRadialMeshGradient,
  type Phase,
} from '@utils/phaseGradient';
import type { ImageMetadata } from 'astro';

export interface Props {
  name: string;
  slug: string;
  description: string;
  client?: string;
  clientLogo?: ImageMetadata;
  phases: Phase[];
  skills?: string[];
  projectStatus?: 'active' | 'complete';
  image?: ImageMetadata;
  class?: string;
}

const {
  name,
  slug,
  description,
  client,
  clientLogo,
  phases,
  skills = [],
  projectStatus = 'complete',
  image,
  class: className = '',
} = Astro.props;

const isActive = projectStatus === 'active';

const orderedActivePhases = getOrderedActivePhases(phases);
const cardGradient = getRadialMeshGradient(slug, orderedActivePhases, 'light');
---

<a
	href={`/projects/${slug}`}
	data-base-href={`/projects/${slug}`}
	class:list={[
		'group relative flex h-full flex-col no-underline shadow-sm transition-colors duration-150 **:no-underline focus-within:z-10 hover:z-10 hover:shadow-md sm:flex-row',
		className,
	]}
	style={`background: ${cardGradient};`}
>
	{
		isActive && (
			<span
				class="absolute top-3 right-3 z-20 inline-flex h-2 w-2"
				role="img"
				title="Active project"
				aria-label="Active project"
			>
				<span class="absolute inset-0 animate-ping rounded-full bg-phase-define opacity-75" />
				<span class="relative inline-flex h-2 w-2 rounded-full bg-phase-define" />
			</span>
		)
	}

	{
		image && (
			<div class="relative isolate mx-5 mt-8 aspect-video overflow-hidden will-change-transform sm:mx-0 sm:mt-0 sm:aspect-auto sm:w-1/2">
				<Image
					src={image}
					alt=""
					aria-hidden="true"
					class="absolute inset-0 h-full w-full scale-110 object-cover blur-2xl"
				/>
				<div class="absolute inset-0 p-5">
					<Image
						src={image}
						alt=""
						aria-hidden="true"
						class="h-full w-full object-contain transition-transform duration-200 group-hover:scale-[1.02]"
					/>
				</div>
			</div>
		)
	}

	<div class="relative z-10 flex flex-1 flex-col p-5">
		<div class="mb-3 h-8 w-32">
			<Image
				src={clientLogo ?? draftlabLogo}
				alt={clientLogo ? (client ?? '') : 'Draftlab'}
				class="h-full w-full object-scale-down object-left grayscale"
			/>
		</div>

		<GradientLink
			as="h2"
			text={name}
			trigger="group-hover"
			class="font-serif text-3xl leading-tight font-normal text-ink md:text-4xl"
		/>

		<p class="mt-3 line-clamp-3 text-sm leading-snug text-ink-soft">
			{description}
		</p>

		{
			skills.length > 0 && (
				<div class="mt-auto flex flex-wrap justify-end gap-2 pt-4">
					{skills.map((slug) => (
						<SkillIcon
							slug={slug}
							size={18}
							tooltip
							class="text-ink-muted transition-colors hover:text-secondary-500"
						/>
					))}
				</div>
			)
		}
	</div>
</a>
