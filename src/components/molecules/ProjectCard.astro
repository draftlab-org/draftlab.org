---
import draftlabLogo from '@assets/draftlab-logo.svg';
import GradientLink from '@components/atoms/GradientLink.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const PHASE_ORDER = ['understand', 'define', 'deliver', 'sustain'] as const;

export interface Props {
  name: string;
  slug: string;
  description: string;
  client?: string;
  clientLogo?: ImageMetadata;
  phases: Array<'understand' | 'define' | 'deliver' | 'sustain'>;
  skills?: string[];
  projectStatus?: 'active' | 'complete';
  featured?: boolean;
  image?: ImageMetadata;
  class?: string;
}

const {
  name,
  slug,
  description,
  client,
  clientLogo,
  phases,
  skills = [],
  projectStatus = 'complete',
  featured = false,
  image,
  class: className = '',
} = Astro.props;

const isActive = projectStatus === 'active';
const phaseSet = new Set(phases);

const phaseLightVar: Record<(typeof PHASE_ORDER)[number], string> = {
  understand: 'var(--color-phase-understand-light)',
  define: 'var(--color-phase-define-light)',
  deliver: 'var(--color-phase-deliver-light)',
  sustain: 'var(--color-phase-sustain-light)',
};

const orderedActivePhases = PHASE_ORDER.filter((p) => phaseSet.has(p));
const gradientStops =
  orderedActivePhases.length === 0
    ? ['var(--color-cream)', 'var(--color-cream)']
    : orderedActivePhases.length === 1
      ? [phaseLightVar[orderedActivePhases[0]], 'var(--color-white)']
      : orderedActivePhases.map((p) => phaseLightVar[p]);
const cardGradient = `linear-gradient(to right, ${gradientStops.join(', ')})`;
---

<a
	href={`/work/${slug}`}
	class:list={[
		'group relative flex h-full overflow-hidden no-underline shadow-sm transition-colors duration-150 **:no-underline hover:shadow-md',
		featured && 'ring-1 ring-secondary-200',
		className,
	]}
	style={`background: ${cardGradient};`}
>
	{
		isActive && (
			<span
				class="absolute top-3 right-3 z-20 h-2.5 w-2.5 rounded-full bg-highlight-300 ring-2 ring-highlight-300/70"
				title="Active project"
				aria-label="Active project"
			/>
		)
	}

	<div class="relative z-10 flex flex-1 flex-col p-5">
		<div class="mb-3 h-8 w-32">
			<Image
				src={clientLogo ?? draftlabLogo}
				alt={clientLogo ? (client ?? '') : 'Draftlab'}
				class="h-full w-full object-scale-down object-left grayscale"
			/>
		</div>

		<GradientLink
			as="h2"
			text={name}
			trigger="group-hover"
			class="font-serif leading-tight font-normal text-ink"
		/>

		<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-soft">
			{description}
		</p>

		{
			skills.length > 0 && (
				<div class="mt-auto flex flex-wrap justify-end gap-2 pt-4">
					{skills.map((slug) => (
						<SkillIcon
							slug={slug}
							size={18}
							class="text-ink-muted transition-colors hover:text-secondary-500"
						/>
					))}
				</div>
			)
		}
	</div>

	{
		image && (
			<div class="relative w-1/2 shrink-0 p-5">
				<Image
					src={image}
					alt=""
					aria-hidden="true"
					class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
				/>
			</div>
		)
	}
</a>
