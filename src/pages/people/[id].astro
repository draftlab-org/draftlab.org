---
import { getCollection } from 'astro:content';
import Image from '@components/atoms/Image.astro';
import JsonLd from '@components/atoms/JsonLd.astro';
import Hero from '@components/organisms/Hero.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { isVisible } from '@utils/content';
import { getSkillBySlug } from '@utils/skills';
import { buildPerson } from '@utils/structuredData';
import type { GetStaticPaths } from 'astro';

// Generate static paths for visible people only
export const getStaticPaths = (async () => {
	const peopleEntries = await getCollection('people');
	return peopleEntries
		.filter((entry) => isVisible(entry))
		.map((entry) => ({
			params: { id: entry.data.id },
			props: { person: entry.data },
		}));
}) satisfies GetStaticPaths;

const { person } = Astro.props;

const base = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, base).href;
const skillNames = (
	await Promise.all((person.skills ?? []).map((slug) => getSkillBySlug(slug)))
)
	.map((sk) => sk?.name)
	.filter((n): n is string => Boolean(n));
const personLd = buildPerson({
	siteUrl: base.href,
	url: pageUrl,
	name: person.name,
	jobTitle: [person.title, person.role].filter(Boolean).join(', ') || undefined,
	description: person.bio,
	imageUrl: new URL(person.headshot.src, base).href,
	sameAs: Object.values(person.social ?? {}),
	knowsAbout: skillNames,
});
---

<PageLayout
	title={person.name}
	description={person.bio || `${person.name}, ${person.title}`}
	image={person.headshot}
>
	<JsonLd slot="head" data={personLd} />
	<Hero
		title={person.name}
		subtitle={person.title}
		size="default"
		background="white"
	/>

	<section class="py-16">
		<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
			<div class="flex flex-col items-center text-center">
				<div class="mb-8">
					<Image
						src={person.headshot}
						alt={person.name}
						width={300}
						height={300}
						class="h-64 w-64 rounded-lg object-cover shadow-lg"
					/>
				</div>

				{person.role && (
					<p class="mb-2 text-sm uppercase tracking-wider text-ink-muted">
						{person.role}
					</p>
				)}

				{person.bio && (
					<p class="mb-8 max-w-xl leading-relaxed">
						{person.bio}
					</p>
				)}

				<a onclick="history.back()" class="default-link cursor-pointer">
					← Back
				</a>
			</div>
		</div>
	</section>
</PageLayout>
