---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ModalityIcon from '@components/atoms/ModalityIcon.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import ProjectUpdatesTimeline from '@components/sections/ProjectUpdatesTimeline.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { isVisible } from '@utils/content';
import type { ModalitySlug } from '@utils/modalityIcons';
import { renderMarkdownWithImages } from '@utils/renderMarkdown';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
	const projects = await getCollection('projects');
	const orgs = await getCollection('organisations');
	const skills = await getCollection('skills');
	const phases = await getCollection('phases');
	const modalities = await getCollection('modalities');

	const orgMap = new Map(orgs.map((o) => [o.data.id, o.data]));
	const skillMap = new Map(
		skills.filter((s) => isVisible(s)).map((s) => [s.data.slug, s.data])
	);
	const phaseMap = new Map(phases.map((p) => [p.data.slug, p.data]));
	const modalityMap = new Map(modalities.map((m) => [m.data.slug, m.data]));

	return projects
		.filter((entry) => isVisible(entry))
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: {
				project: entry.data,
				client: entry.data.client ? orgMap.get(entry.data.client) : undefined,
				resolvedPartners: (entry.data.partners ?? [])
					.map((p: string) => orgMap.get(p))
					.filter(Boolean),
				resolvedSkills: (entry.data.skills ?? [])
					.map((s: string) => skillMap.get(s))
					.filter(Boolean),
				resolvedPhases: entry.data.phases
					.map((p: string) => phaseMap.get(p))
					.filter(Boolean),
				resolvedModalities: entry.data.modalities
					.map((m: string) => modalityMap.get(m))
					.filter(Boolean),
			},
		}));
}) satisfies GetStaticPaths;

const {
	project,
	client,
	resolvedPartners,
	resolvedSkills,
	resolvedPhases,
	resolvedModalities,
} = Astro.props;
const bodyHtml = project.body
	? (await renderMarkdownWithImages(project.body)).html
	: '';
const isActive = project.projectStatus === 'active';

const PHASE_ORDER = ['understand', 'define', 'deliver', 'sustain'] as const;

const phaseSet = new Set(project.phases);

const statusLabel = isActive ? 'Active' : 'Complete';
---

<PageLayout
	title={project.name}
	description={project.description}
>
	<article class="mx-auto max-w-3xl px-4 pt-10 pb-20 sm:px-6 lg:px-8">
		{/* Back link */}
		<a
			href="/projects"
			data-component
			class="group mb-10 inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-secondary-600"
		>
			<span class="transition-transform group-hover:-translate-x-0.5">&larr;</span>
			All projects
		</a>

		{/* Hero image — only when present, framed in corner-brackets */}
		{
			project.image && (
				<figure class="corner-brackets mb-10 aspect-3/2 w-full p-3 text-ink">
					<div class="h-full w-full overflow-hidden">
						<Image
							src={project.image}
							alt={project.name}
							class="block h-full w-full object-cover"
						/>
					</div>
				</figure>
			)
		}

		{/* Identity zone — title, phases, credits */}
		<header class="mb-10">
			<h1
				class="font-serif text-4xl leading-[1.05] font-medium text-ink md:text-6xl"
			>
				{project.name}
			</h1>

			{/* Credits — FOR client · WITH partners, single wrapping line */}
			{
				(client || resolvedPartners.length > 0) && (
					<div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
						{client && (
							<span class="inline-flex items-center gap-3">
								<span class="font-mono text-[0.6rem] tracking-[0.22em] text-ink-muted uppercase">
									For
								</span>
								{client.url ? (
									<a
										href={client.url}
										target="_blank"
										rel="noopener noreferrer"
										title={client.name}
										class="inline-flex items-center"
									>
										{client.image ? (
											<img
												src={client.image.src}
												alt={client.name}
												class="h-9 w-auto"
											/>
										) : (
											<span class="font-serif text-base text-ink italic">
												{client.name}
											</span>
										)}
									</a>
								) : client.image ? (
									<img
										src={client.image.src}
										alt={client.name}
										class="h-9 w-auto"
										title={client.name}
									/>
								) : (
									<span class="font-serif text-base text-ink italic">
										{client.name}
									</span>
								)}
							</span>
						)}
						{resolvedPartners.length > 0 && (
							<span class="inline-flex flex-wrap items-center gap-x-3 gap-y-2">
								<span class="font-mono text-[0.6rem] tracking-[0.22em] text-ink-muted uppercase">
									With
								</span>
								{resolvedPartners.map((partner: any, idx: number) => (
									<>
										{idx > 0 && (
											<span
												class="font-mono text-xs text-ink-muted"
												aria-hidden="true"
											>
												·
											</span>
										)}
										{partner.url ? (
											<a
												href={partner.url}
												target="_blank"
												rel="noopener noreferrer"
												title={partner.name}
												class="inline-flex items-center"
											>
												{partner.image ? (
													<img
														src={partner.image.src}
														alt={partner.name}
														class="h-7 w-auto"
													/>
												) : (
													<span class="text-sm text-ink-muted">{partner.name}</span>
												)}
											</a>
										) : partner.image ? (
											<img
												src={partner.image.src}
												alt={partner.name}
												class="h-7 w-auto"
												title={partner.name}
											/>
										) : (
											<span class="text-sm text-ink-muted">{partner.name}</span>
										)}
									</>
								))}
							</span>
						)}
					</div>
				)
			}
		</header>

		{/* Colophon — compressed metadata strip */}
		<span class="block gradient-rule mb-5" aria-hidden="true"></span>
		<dl
			class="grid grid-cols-1 items-start gap-x-6 gap-y-6 pb-5 sm:grid-cols-2"
		>
			<div class="flex flex-col sm:col-span-2">
				<dt
					class="font-mono text-[0.6rem] tracking-[0.22em] text-ink-muted uppercase"
				>
					Phases
				</dt>
				<dd class="mt-3">
					<div
						class="flex items-center gap-2 sm:gap-3"
						role="group"
						aria-label="Project phases covered"
					>
						{
							PHASE_ORDER.map((phase, i) => {
								const active = phaseSet.has(phase as any);
								return (
									<>
										{i > 0 && (
											<span class="flex-1 gradient-rule" aria-hidden="true" />
										)}
										<span
											class="inline-flex shrink-0 items-center gap-2 font-mono text-[0.65rem] tracking-[0.2em] uppercase sm:text-sm sm:tracking-wider"
											aria-current={active ? 'true' : undefined}
										>
											{active ? (
												<span
													class="h-2 w-2 shrink-0 rounded-full"
													style={`background: var(--color-phase-${phase}-dark);`}
													aria-hidden="true"
												/>
											) : (
												<span
													class="h-2 w-2 shrink-0 rounded-full border border-ink-muted/35"
													aria-hidden="true"
												/>
											)}
											<span
												class:list={[!active && 'text-ink-muted']}
												style={
													active
														? `color: var(--color-phase-${phase}-dark);`
														: undefined
												}
											>
												{phase}
											</span>
										</span>
									</>
								);
							})
						}
					</div>
				</dd>
			</div>
			<div class="flex flex-col">
				<dt
					class="font-mono text-[0.6rem] tracking-[0.22em] text-ink-muted uppercase"
				>
					Modality
				</dt>
				<dd
					class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-sm tracking-wider text-ink uppercase"
				>
					{
						resolvedModalities.length > 0 ? (
							resolvedModalities.map((modality: any, idx: number) => (
								<>
									{idx > 0 && (
										<span class="text-ink-muted" aria-hidden="true">
											·
										</span>
									)}
									<span class="inline-flex items-center gap-1.5">
										<ModalityIcon
											slug={modality.slug as ModalitySlug}
											size={12}
											class="shrink-0 text-ink-muted"
											decorative
										/>
										{modality.name}
									</span>
								</>
							))
						) : (
							<span>—</span>
						)
					}
				</dd>
			</div>
			<div class="flex flex-col">
				<dt
					class="font-mono text-[0.6rem] tracking-[0.22em] text-ink-muted uppercase"
				>
					Status
				</dt>
				<dd
					class:list={[
						'mt-2 inline-flex items-center gap-2 font-mono text-sm tracking-wider uppercase',
						isActive ? 'text-phase-understand-dark' : 'text-ink',
					]}
				>
					{
						isActive && (
							<span
								class="relative inline-flex h-2 w-2 shrink-0"
								aria-hidden="true"
							>
								<span class="absolute inset-0 animate-ping rounded-full bg-phase-understand opacity-75" />
								<span class="relative inline-flex h-2 w-2 rounded-full bg-phase-understand" />
							</span>
						)
					}
					{statusLabel}
				</dd>
			</div>
		</dl>
		<span class="block gradient-rule mb-12" aria-hidden="true"></span>

		{/* Narrative — lead + body */}
		<section class="mb-12">
			<p class="font-serif text-xl leading-relaxed text-ink-soft md:text-[1.4rem]">
				{project.description}
			</p>
			{
				bodyHtml && (
					<div
						class="prose-ink prose mt-6 max-w-none leading-relaxed text-ink-soft"
						set:html={bodyHtml}
					/>
				)
			}
		</section>

		{/* Skills */}
		{
			resolvedSkills.length > 0 && (
				<section class="mb-12 pt-8"><span class="block gradient-rule -mt-8 mb-8" aria-hidden="true"></span>
					<h2 class="mb-4 font-serif text-sm font-medium tracking-widest text-ink-muted uppercase">
						Skills applied
					</h2>
					<div class="flex flex-wrap gap-2.5">
						{resolvedSkills.map((skill: any) => (
							<span class="inline-flex items-center gap-2 border border-ink-muted/30 bg-white px-3 py-1.5 text-sm text-ink-soft">
								<SkillIcon
									slug={skill.slug}
									size={16}
									class="text-secondary-500"
								/>
								{skill.name}
							</span>
						))}
					</div>
				</section>
			)
		}

		{/* Updates */}
		<div class="pt-8"><span class="block gradient-rule -mt-8 mb-8" aria-hidden="true"></span>
			<ProjectUpdatesTimeline updates={project.updates} />
		</div>

		{/* External link */}
		{
			project.url && (
				<div class="mt-12 pt-8"><span class="block gradient-rule -mt-8 mb-8" aria-hidden="true"></span>
					<a
						href={project.url}
						target="_blank"
						rel="noopener noreferrer"
						data-component
						class="button-base button-outline button-size-md inline-flex items-center gap-2"
					>
						Visit project
						<span class="text-xs">&nearr;</span>
					</a>
				</div>
			)
		}

		{/* Back to feed */}
		<div class="mt-16 pt-8"><span class="block gradient-rule -mt-8 mb-8" aria-hidden="true"></span>
			<a
				href="/projects"
				data-component
				class="group inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-secondary-600"
			>
				<span class="transition-transform group-hover:-translate-x-0.5">&larr;</span>
				Back to all projects
			</a>
		</div>
	</article>
</PageLayout>
