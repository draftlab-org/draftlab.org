---
import { getCollection, render } from 'astro:content';
import ModalityIcon from '@components/atoms/ModalityIcon.astro';
import SkillIcon from '@components/atoms/SkillIcon.astro';
import PageLayout from '@layouts/PageLayout.astro';
import { isVisible } from '@utils/content';
import type { ModalitySlug } from '@utils/modalityIcons';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
	const projects = await getCollection('projects');
	const orgs = await getCollection('organisations');
	const skills = await getCollection('skills');
	const phases = await getCollection('phases');
	const modalities = await getCollection('modalities');

	const orgMap = new Map(orgs.map((o) => [o.data.id, o.data]));
	const skillMap = new Map(skills.filter((s) => isVisible(s)).map((s) => [s.data.slug, s.data]));
	const phaseMap = new Map(phases.map((p) => [p.data.slug, p.data]));
	const modalityMap = new Map(modalities.map((m) => [m.data.slug, m.data]));

	return projects
		.filter((entry) => isVisible(entry))
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: {
				entry,
				project: entry.data,
				client: entry.data.client ? orgMap.get(entry.data.client) : undefined,
				resolvedPartners: (entry.data.partners ?? []).map((p: string) => orgMap.get(p)).filter(Boolean),
				resolvedSkills: (entry.data.skills ?? []).map((s: string) => skillMap.get(s)).filter(Boolean),
				resolvedPhases: entry.data.phases.map((p: string) => phaseMap.get(p)).filter(Boolean),
				resolvedModalities: entry.data.modalities.map((m: string) => modalityMap.get(m)).filter(Boolean),
			},
		}));
}) satisfies GetStaticPaths;

const { entry, project, client, resolvedPartners, resolvedSkills, resolvedPhases, resolvedModalities } = Astro.props;
const { Content } = await render(entry);
const isActive = project.projectStatus === 'active';

const PHASE_ORDER = ['understand', 'define', 'deliver', 'sustain'];
const orderedPhases = [...resolvedPhases].sort(
	(a: any, b: any) => PHASE_ORDER.indexOf(a.slug) - PHASE_ORDER.indexOf(b.slug)
);
const orderedPhaseSlugs = [...project.phases].sort(
	(a: string, b: string) => PHASE_ORDER.indexOf(a) - PHASE_ORDER.indexOf(b)
);

const phaseColorClass = {
	understand: 'bg-phase-understand',
	define: 'bg-phase-define',
	deliver: 'bg-phase-deliver',
	sustain: 'bg-phase-sustain',
};

const phaseBg: Record<string, string> = {
	understand: 'bg-phase-understand-light',
	define: 'bg-phase-define-light',
	deliver: 'bg-phase-deliver-light',
	sustain: 'bg-phase-sustain-light',
};

const phaseText: Record<string, string> = {
	understand: 'text-phase-understand-dark',
	define: 'text-phase-define-dark',
	deliver: 'text-phase-deliver-dark',
	sustain: 'text-phase-sustain-dark',
};

const phaseSet = new Set(project.phases);
---

<PageLayout
	title={`${project.name} — Draftlab`}
	description={project.description}
>
	{/* Phase accent bar across the top */}
	<!-- <div class="flex h-1.5">
		{orderedPhaseSlugs.map((phase: string) => (
			<div class:list={['flex-1', phaseColorClass[phase as keyof typeof phaseColorClass]]} />
		))}
	</div> -->

	<article class="mx-auto max-w-3xl px-4 pt-12 pb-20 sm:px-6 lg:px-8">
		{/* Back link */}
		<a
			href="/work"
			data-component
			class="group mb-10 inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-secondary-600"
		>
			<span class="transition-transform group-hover:-translate-x-0.5"
				>&larr;</span
			>
			All projects
		</a>

		{/* Header */}
		<header class="mb-12">
			<h1
				class="font-serif text-4xl font-bold tracking-tight text-ink md:text-5xl"
			>
				{project.name}
			</h1>

			{
				client && (
					<div class="mt-5 flex items-center gap-3">
						<span class="font-serif text-[0.7rem] tracking-[0.1em] text-ink-muted uppercase">
							Client
						</span>
						{client.url ? (
							<a
								href={client.url}
								target="_blank"
								rel="noopener noreferrer"
								title={client.name}
								class="inline-flex items-center"
							>
								{client.image ? (
									<img
										src={client.image.src}
										alt={client.name}
										class="h-10 w-auto"
									/>
								) : (
									<span class="font-serif text-lg text-ink-muted italic">
										{client.name}
									</span>
								)}
							</a>
						) : client.image ? (
							<img
								src={client.image.src}
								alt={client.name}
								class="h-10 w-auto"
								title={client.name}
							/>
						) : (
							<span class="font-serif text-lg text-ink-muted italic">
								{client.name}
							</span>
						)}
					</div>
				)
			}

			{
				resolvedPartners.length > 0 && (
					<div class="mt-4 flex flex-wrap items-center gap-4">
						<span class="font-serif text-[0.7rem] tracking-[0.1em] text-ink-muted uppercase">
							With
						</span>
						{resolvedPartners.map((partner: any) =>
							partner.url ? (
								<a
									href={partner.url}
									target="_blank"
									rel="noopener noreferrer"
									title={partner.name}
									class="inline-flex items-center"
								>
									{partner.image ? (
										<img
											src={partner.image.src}
											alt={partner.name}
											class="h-8 w-auto"
										/>
									) : (
										<span class="text-sm text-ink-muted">{partner.name}</span>
									)}
								</a>
							) : partner.image ? (
								<img
									src={partner.image.src}
									alt={partner.name}
									class="h-8 w-auto"
									title={partner.name}
								/>
							) : (
								<span class="text-sm text-ink-muted">{partner.name}</span>
							)
						)}
					</div>
				)
			}

			{/* Status badge */}
			{
				isActive && (
					<span class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-phase-understand-light px-3 py-1 text-xs font-medium text-phase-understand-dark">
						<span class="h-1.5 w-1.5 animate-pulse rounded-full bg-phase-understand" />
						Active project
					</span>
				)
			}
		</header>

		{/* Description */}
		<section class="mb-12">
			<p class="text-lg leading-relaxed text-ink-soft">
				{project.description}
			</p>
			<div
				class="prose-ink prose mt-4 max-w-none leading-relaxed text-ink-soft"
			>
				<Content />
			</div>
		</section>

		{/* Phases bar */}
		<section class="mb-12">
			<h2 class="mb-3 font-serif text-sm font-medium tracking-wider text-ink-muted uppercase">
				Phases
			</h2>
			<div class="relative flex h-8 drop-shadow-xs/30">
				{PHASE_ORDER.map((phase, i) => {
					const active = phaseSet.has(phase as any);
					const isFirst = i === 0;
					return (
						<div
							class:list={[
								'relative flex flex-1 items-end',
								!isFirst && '-ml-2',
								active ? phaseBg[phase] : 'bg-cream',
							]}
							style="clip-path: polygon(10% 0, 100% 0, 90% 100%, 0% 100%);"
						>
							<span
								class:list={[
									'truncate pr-1 pl-3 font-serif text-xs capitalize',
									active ? phaseText[phase] : 'text-gray-400',
								]}
							>
								{phase}
							</span>
						</div>
					);
				})}
			</div>
		</section>

		{/* Modalities */}
		<section class="mb-12">
			<div>
				<h2
					class="mb-3 font-serif text-sm font-medium tracking-wider text-ink-muted uppercase"
				>
					Modalities
				</h2>
				<div class="space-y-2">
					{
						resolvedModalities.map((modality: any) => (
							<div class="flex items-center gap-3">
								<ModalityIcon
									slug={modality.slug as ModalitySlug}
									size={16}
									class="shrink-0 text-ink-muted"
									decorative
								/>
								<div>
									<span class="font-serif text-base font-medium text-ink">
										{modality.name}
									</span>
									<span class="ml-2 text-sm text-ink-muted">
										{modality.tagline}
									</span>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{/* Skills */}
		{
			resolvedSkills.length > 0 && (
				<section class="mb-12">
					<h2 class="mb-4 font-serif text-sm font-medium tracking-wider text-ink-muted uppercase">
						Skills applied
					</h2>
					<div class="flex flex-wrap gap-3">
						{resolvedSkills.map((skill: any) => (
							<span class="inline-flex items-center gap-2 rounded-md border border-sand bg-cream-dark/40 px-3 py-1.5 text-sm text-ink-soft">
								<SkillIcon
									slug={skill.slug}
									size={16}
									class="text-secondary-500"
								/>
								{skill.name}
							</span>
						))}
					</div>
				</section>
			)
		}

		{/* Timeline */}
		{
			(project.yearStart || project.yearEnd) && (
				<section class="mb-12">
					<h2 class="mb-3 font-serif text-sm font-medium tracking-wider text-ink-muted uppercase">
						Timeline
					</h2>
					<p class="text-base text-ink-soft">
						{project.yearStart && <span>{project.yearStart}</span>}
						{project.yearStart && project.yearEnd && <span> — </span>}
						{project.yearEnd && <span>{project.yearEnd}</span>}
						{project.yearStart && !project.yearEnd && isActive && (
							<span> — ongoing</span>
						)}
					</p>
				</section>
			)
		}

		{/* External link */}
		{
			project.url && (
				<div class="mt-12 border-t border-sand pt-8">
					<a
						href={project.url}
						target="_blank"
						rel="noopener noreferrer"
						data-component
						class="button-base button-outline button-size-md inline-flex items-center gap-2"
					>
						Visit project
						<span class="text-xs">&nearr;</span>
					</a>
				</div>
			)
		}

		{/* Back to work */}
		<div class="mt-16 border-t border-sand pt-8">
			<a
				href="/work"
				data-component
				class="group inline-flex items-center gap-1.5 text-sm text-ink-muted transition-colors hover:text-secondary-600"
			>
				<span class="transition-transform group-hover:-translate-x-0.5"
					>&larr;</span
				>
				Back to all projects
			</a>
		</div>
	</article>
</PageLayout>
