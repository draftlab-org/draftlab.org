---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Banner from '@components/atoms/Banner.astro';
import Link from '@components/atoms/Link'
import Tag from '@components/atoms/Tag';
import ShareButtons from '@components/molecules/ShareButtons.astro';
import ContentSidebar from '@components/organisms/ContentSidebar.astro';
import RelatedContentItems from '@components/organisms/RelatedContentItems.astro';
import TOC from '@components/organisms/TOC';
import HeroSection from '@components/sections/HeroSection.astro';
import PageLayout from '@layouts/PageLayout.astro';
import SectionLayout from '@layouts/SectionLayout.astro';
import { getArticleExcerpt, getArticleUrl, getRelatedArticles } from '@utils/articles';
import { isVisible, mapColorToVariant } from '@utils/content';
import { showDraftLabels } from '@utils/dev';
import { articleNode } from '@utils/jsonld';
import { getPersonUrl, resolvePeople } from '@utils/people';
import { countTocEntries, getTocEntries } from '@utils/renderMarkdown';
import { getResourcesByIds } from '@utils/resources';
import { absoluteUrl, ogCardUrl } from '@utils/seo';

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  // In production, only build published/archived articles. In dev/preview, build all.
  return articles
    .filter((article) => isVisible(article))
    .map((article) => ({
      params: { slug: article.id },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

// Table of contents: only worth showing with at least two headings
const tocEntries = getTocEntries(headings);
const showToc = countTocEntries(tocEntries) >= 2;

// Author details — visible people only, so draft profiles aren't named or
// linked (their pages don't exist in production)
const authors = await resolvePeople(article.data.authors);

// Related content: explicit picks first, then articles sharing categories
const relatedArticles = await getRelatedArticles(article);
const relatedResources = await getResourcesByIds(
  article.data.relatedResources ?? []
);

// Absolute URL for share links
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// Format date
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);
};

const {title, publishedDate, heroImage, categories, status } = article.data

const siteConfig = await getEntry('site', 'config');
const archivedBanner = siteConfig?.data.archivedBanner;

// SEO: description, Open Graph article meta and schema.org Article node
const authorNames = authors.map((a) => a.name).join(', ');
const seoDescription =
	article.data.seoDescription ||
	getArticleExcerpt(article, 160) ||
	(authorNames ? `Article by ${authorNames}` : undefined);
const articleUrl = absoluteUrl(getArticleUrl(article));
const authorEntities = authors.map((a) => ({
	name: a.name,
	url: absoluteUrl(getPersonUrl(a)),
}));
const articleMeta = {
	publishedTime: publishedDate,
	authors: authorEntities.map((a) => a.url),
	section: categories?.[0],
	tags: categories ?? undefined,
};
const articleJsonLd = articleNode({
	url: articleUrl,
	title,
	description: seoDescription,
	image: heroImage
		? (ogCardUrl(getArticleUrl(article)) ?? absoluteUrl(heroImage.src))
		: undefined,
	datePublished: publishedDate,
	authors: authorEntities,
	categories: categories ?? undefined,
});
---

<PageLayout
	title={article.data.seoTitle ?? article.data.title}
	breadcrumbTitle={article.data.title}
	description={seoDescription}
	image={heroImage}
	ogType="article"
	article={articleMeta}
	jsonLd={articleJsonLd}
>
	{
		status === 'archived' && archivedBanner && (
			<Banner variant={mapColorToVariant(archivedBanner.color)} dismissible>
				{archivedBanner.message}
			</Banner>
		)
	}

	<!-- Article Header -->
	<SectionLayout bgImage={heroImage} sectionLabel="hero">
		<HeroSection title={title}>
			{/* Draft badge (dev and preview builds only) */}
			{
				showDraftLabels && status === 'draft' && (
					<div class="mb-4">
						<Tag variant="highlight" size="md" class="font-bold">
							DRAFT
						</Tag>
					</div>
				)
			}
			{/* Categories */}
			<div class="mb-4 flex flex-wrap gap-2">
				{
					(categories ?? []).map((category) => (
						<Tag variant="primary" size="md">
							{category}
						</Tag>
					))
				}
			</div>

			{/* Metadata */}
			<div class="flex flex-wrap items-center gap-4 text-gray-700">
				<p class="text-base">
					By <span class="font-medium"
						>{
							authors.map((a, i) => (
								<>
									<Link variant="unstyled" href={`/people/${a?.id}`}>
										{a?.name}
									</Link>
									{i < authors.length - 1 && '•'}
								</>
							))
						}</span
					>
				</p>
				<span class="text-gray-400">•</span>
				<p class="text-base">
					{formatDate(publishedDate)}
				</p>
			</div>
		</HeroSection>
	</SectionLayout>

	<!-- Article Content -->
	<SectionLayout>
		<div class="py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
			<div class="min-w-0">
				{/* Mobile table of contents (the sidebar handles desktop) */}
				{
					showToc && (
						<details class="mx-auto mb-8 max-w-4xl rounded-lg border border-gray-200 p-4 lg:hidden">
							<summary class="cursor-pointer font-medium">On this page</summary>
							<div class="mt-4">
								<TOC client:visible entries={tocEntries} title="" sticky={false} />
							</div>
						</details>
					)
				}

				<article class="mx-auto prose max-w-4xl prose-blue">
					<Content />
				</article>

				<ShareButtons url={shareUrl} title={title} id="share-inline" class="mx-auto mt-12 max-w-4xl lg:hidden" />
			</div>

			<ContentSidebar
				tocEntries={showToc ? tocEntries : []}
				shareUrl={shareUrl}
				shareTitle={title}
			/>
		</div>
	</SectionLayout>

	<!-- Related Content -->
	{
		(relatedArticles.length > 0 || relatedResources.length > 0) && (
			<SectionLayout bgColor="gray">
				<RelatedContentItems articles={relatedArticles} resources={relatedResources} />
			</SectionLayout>
		)
	}

	<!-- Authors Section -->
	{
		authors && (
			<SectionLayout bgColor="gray">
				<div class="mx-auto max-w-4xl py-12">
					<h2 class="mb-8 text-2xl font-bold">
						{authors.length === 1 ? 'About the Author' : 'About the Authors'}
					</h2>
					<div class="grid gap-6 md:grid-cols-2">
						{authors.map(
							(author) =>
								author && (
									<Link
										variant="unstyled"
										href={`/people/${author.id}`}
										class="flex gap-4 rounded-lg bg-white p-6 no-underline transition hover:shadow-sm"
									>
										{author.headshot && (
											<Image
												src={author.headshot}
												alt={author.name}
												class="h-16 w-16 rounded-full object-cover"
											/>
										)}

										<div>
											<h3 class="mb-1 text-lg font-semibold">{author.name}</h3>
											<p class="text-sm">{author.title}</p>
										</div>
									</Link>
								)
						)}
					</div>
				</div>
			</SectionLayout>
		)
	}
</PageLayout>
