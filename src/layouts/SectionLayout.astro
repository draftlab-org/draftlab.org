---
import { Image } from 'astro:assets';
import Highlight from '@assets/highlight.svg'
import DevOnly from '@components/atoms/DevOnly.astro';
import { devClass } from '@utils/dev';
import type { ImageMetadata } from 'astro';


export type VerticalSpace = 'narrow' | 'normal' | 'wide';

export interface Props {
  containerized?: boolean;
  maxWidth?: 'full' | '7xl' | '6xl' | '5xl' | '4xl';
  padding?: boolean;
  verticalSpace?: VerticalSpace;
  class?: string;
  bgColor?: string;
  bgType?: string;
  bgImage?: ImageMetadata;
	sectionLabel?: string
}

const {
  containerized = true,
  maxWidth = '7xl',
  padding = true,
  verticalSpace = 'normal',
  class: className = '',
  bgImage,
  bgColor,
  bgType = 'full',
	sectionLabel = 'section'
} = Astro.props;

const maxWidths = {
  full: 'max-w-full',
  '7xl': 'max-w-7xl',
  '6xl': 'max-w-6xl',
  '5xl': 'max-w-5xl',
  '4xl': 'max-w-4xl',
};

// Vertical-space tiers. Single source of truth for section breathing room —
// individual section components no longer carry their own py-* utilities.
// Tune the rhythm here once and every section that flows through SectionLayout
// follows. `padding` still controls horizontal padding only.
const verticalSpaces: Record<VerticalSpace, string> = {
  narrow: 'py-4 md:py-8 lg:py-12',
  normal: 'py-8 md:py-12 lg:py-16',
  wide: 'py-10 md:py-16 lg:py-28',
};

const containerClass = containerized ? `mx-auto ${maxWidths[maxWidth]}` : '';
const horizontalPaddingClass = padding ? 'px-4 sm:px-6 lg:px-8' : '';
const verticalPaddingClass = verticalSpaces[verticalSpace];
const paddingClass = `${horizontalPaddingClass} ${verticalPaddingClass}`.trim();

const backgrounds = {
  white: 'bg-white',
  gray: 'bg-gray-50',
  gradient: 'bg-gradient-to-br from-blue-50 to-indigo-100',
  'phase-gradient': 'mesh-phase',
  'phase-gradient-light': 'mesh-phase-light',
};

const bgClass = backgrounds[bgColor as keyof typeof backgrounds] || "";
const sectionBgClass = bgType === 'full' ? bgClass : '';
const containerBgClass = bgType === 'contained' ? bgClass : '';
---

<section
	class={`relative ${sectionBgClass} ${devClass('border-t border-b border-gray-300 border-dotted')}`}
>
	<DevOnly>
		<span
			class="absolute top-0 left-0 bg-primary-300 p-1 text-sm text-primary-600 uppercase"
			>{sectionLabel}</span
		>
	</DevOnly>
	{
		bgImage && (
			<Image
				src={bgImage}
				alt=""
				class="absolute inset-0 -z-10 h-full w-full object-cover"
				loading="eager"
			/>
		)
	}
	{
		bgType === 'highlight' && (
			<Image
				src={Highlight}
				alt=""
				class="absolute inset-0 -z-10 h-full w-full object-contain"
				loading="eager"
			/>
		)
	}
	<div
		class={`section-container relative  ${containerClass} ${paddingClass} ${containerBgClass} ${className}`}
	>
		<slot />
	</div>
</section>
