{
  "yaml.schemas": {
    "./.astro/collections/pages.schema.json": "/src/content/pages/*.yaml",
    "./.astro/collections/projects.schema.json": "/src/content/projects/*.yaml"
  },
  "json.schemas": [
    {
      "fileMatch": ["/src/content/categories/*.json"],
      "url": "./.astro/collections/categories.schema.json"
    },
    {
      "fileMatch": ["/src/content/frameworkCells/*.json"],
      "url": "./.astro/collections/frameworkCells.schema.json"
    },
    {
      "fileMatch": ["/src/content/modalities/*.json"],
      "url": "./.astro/collections/modalities.schema.json"
    },
    {
      "fileMatch": ["/src/content/navigation/*.json"],
      "url": "./.astro/collections/navigation.schema.json"
    },
    {
      "fileMatch": ["/src/content/organisations/*.json"],
      "url": "./.astro/collections/organisations.schema.json"
    },
    {
      "fileMatch": ["/src/content/people/*.json"],
      "url": "./.astro/collections/people.schema.json"
    },
    {
      "fileMatch": ["/src/content/phases/*.json"],
      "url": "./.astro/collections/phases.schema.json"
    },
    {
      "fileMatch": ["/src/content/quotes/*.json"],
      "url": "./.astro/collections/quotes.schema.json"
    },
    {
      "fileMatch": ["/src/content/site/*.json"],
      "url": "./.astro/collections/site.schema.json"
    },
    {
      "fileMatch": ["/src/content/skills/*.json"],
      "url": "./.astro/collections/skills.schema.json"
    }
  ]
}
